    "message": "Premium website training example 04.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <title>VERDE — Conscious Fashion</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #173d2b;\r\n            --primary-dark: #0d281b;\r\n            --accent: #b58a55;\r\n            --background: #f7f5f0;\r\n            --surface: #ffffff;\r\n            --surface-soft: #eeece5;\r\n            --text: #1b1b19;\r\n            --muted: #6d7069;\r\n            --border: #deddd6;\r\n            --success: #2e7d50;\r\n            --shadow: 0 15px 45px rgba(20, 32, 24, 0.08);\r\n            --radius: 18px;\r\n            --max-width: 1240px;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        html {\r\n            scroll-behavior: smooth;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, Helvetica, sans-serif;\r\n            background: var(--background);\r\n            color: var(--text);\r\n            line-height: 1.6;\r\n        }\r\n\r\n        a {\r\n            text-decoration: none;\r\n            color: inherit;\r\n        }\r\n\r\n        button,\r\n        input {\r\n            font: inherit;\r\n        }\r\n\r\n        button {\r\n            cursor: pointer;\r\n        }\r\n\r\n        .container {\r\n            width: min(92%, var(--max-width));\r\n            margin: auto;\r\n        }\r\n\r\n        /* NAVBAR */\r\n\r\n        header {\r\n            position: sticky;\r\n            top: 0;\r\n            z-index: 1000;\r\n            background: rgba(247, 245, 240, 0.94);\r\n            backdrop-filter: blur(12px);\r\n            border-bottom: 1px solid transparent;\r\n            transition: 0.3s ease;\r\n        }\r\n\r\n        header.scrolled {\r\n            border-color: var(--border);\r\n        }\r\n\r\n        .navbar {\r\n            min-height: 76px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 30px;\r\n        }\r\n\r\n        .logo {\r\n            font-size: 1.5rem;\r\n            font-weight: 800;\r\n            letter-spacing: 4px;\r\n            color: var(--primary);\r\n        }\r\n\r\n        .nav-links {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 28px;\r\n        }\r\n\r\n        .nav-links a {\r\n            color: var(--muted);\r\n            font-size: 0.94rem;\r\n            transition: color 0.2s ease;\r\n        }\r\n\r\n        .nav-links a:hover {\r\n            color: var(--primary);\r\n        }\r\n\r\n        .nav-actions {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 14px;\r\n        }\r\n\r\n        .cart-button,\r\n        .menu-button {\r\n            border: 1px solid var(--border);\r\n            background: transparent;\r\n            color: var(--text);\r\n            padding: 10px 15px;\r\n            border-radius: 999px;\r\n            transition: 0.25s ease;\r\n        }\r\n\r\n        .cart-button:hover,\r\n        .menu-button:hover {\r\n            background: var(--primary);\r\n            color: white;\r\n            border-color: var(--primary);\r\n        }\r\n\r\n        .cart-count {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            width: 20px;\r\n            height: 20px;\r\n            background: var(--accent);\r\n            color: white;\r\n            border-radius: 50%;\r\n            font-size: 0.72rem;\r\n            margin-left: 5px;\r\n        }\r\n\r\n        .menu-button {\r\n            display: none;\r\n        }\r\n\r\n        /* HERO */\r\n\r\n        .hero {\r\n            min-height: 700px;\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            align-items: center;\r\n            gap: 70px;\r\n            padding: 70px 0;\r\n        }\r\n\r\n        .eyebrow {\r\n            display: inline-block;\r\n            color: var(--accent);\r\n            font-size: 0.78rem;\r\n            font-weight: 700;\r\n            letter-spacing: 2px;\r\n            text-transform: uppercase;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        .hero h1 {\r\n            font-size: clamp(3rem, 6vw, 6.5rem);\r\n            line-height: 0.98;\r\n            letter-spacing: -3px;\r\n            color: var(--primary);\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .hero p {\r\n            max-width: 560px;\r\n            color: var(--muted);\r\n            font-size: 1.08rem;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .hero-actions {\r\n            display: flex;\r\n            gap: 14px;\r\n            flex-wrap: wrap;\r\n        }\r\n\r\n        .primary-button,\r\n        .secondary-button {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            min-height: 50px;\r\n            padding: 0 24px;\r\n            border-radius: 999px;\r\n            font-weight: 600;\r\n            transition: 0.25s ease;\r\n        }\r\n\r\n        .primary-button {\r\n            background: var(--primary);\r\n            color: white;\r\n            border: 1px solid var(--primary);\r\n        }\r\n\r\n        .primary-button:hover {\r\n            background: var(--primary-dark);\r\n            transform: translateY(-2px);\r\n        }\r\n\r\n        .secondary-button {\r\n            border: 1px solid var(--border);\r\n            background: transparent;\r\n        }\r\n\r\n        .secondary-button:hover {\r\n            border-color: var(--primary);\r\n            color: var(--primary);\r\n        }\r\n\r\n        .hero-stats {\r\n            display: flex;\r\n            gap: 38px;\r\n            margin-top: 48px;\r\n        }\r\n\r\n        .hero-stat strong {\r\n            display: block;\r\n            color: var(--primary);\r\n            font-size: 1.5rem;\r\n        }\r\n\r\n        .hero-stat span {\r\n            color: var(--muted);\r\n            font-size: 0.85rem;\r\n        }\r\n\r\n        .hero-visual {\r\n            position: relative;\r\n        }\r\n\r\n        .hero-image {\r\n            height: 600px;\r\n            border-radius: 24px;\r\n            overflow: hidden;\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        .hero-image img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n        }\r\n\r\n        .floating-card {\r\n            position: absolute;\r\n            left: -40px;\r\n            bottom: 40px;\r\n            max-width: 260px;\r\n            background: rgba(255, 255, 255, 0.96);\r\n            backdrop-filter: blur(10px);\r\n            border-radius: var(--radius);\r\n            padding: 20px;\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        .floating-card small {\r\n            display: block;\r\n            color: var(--muted);\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .floating-card strong {\r\n            color: var(--primary);\r\n        }\r\n\r\n        /* TRUST */\r\n\r\n        .trust {\r\n            padding: 28px 0;\r\n            border-top: 1px solid var(--border);\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .trust-content {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 30px;\r\n            flex-wrap: wrap;\r\n        }\r\n\r\n        .trust p {\r\n            color: var(--muted);\r\n        }\r\n\r\n        .trust-brands {\r\n            display: flex;\r\n            gap: 35px;\r\n            color: var(--primary);\r\n            font-weight: 700;\r\n            letter-spacing: 1px;\r\n            flex-wrap: wrap;\r\n        }\r\n\r\n        /* SECTIONS */\r\n\r\n        section {\r\n            padding: 100px 0;\r\n        }\r\n\r\n        .section-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: end;\r\n            gap: 30px;\r\n            margin-bottom: 45px;\r\n        }\r\n\r\n        .section-header h2 {\r\n            font-size: clamp(2.2rem, 4vw, 4rem);\r\n            color: var(--primary);\r\n            letter-spacing: -2px;\r\n            line-height: 1;\r\n        }\r\n\r\n        .section-header p {\r\n            max-width: 500px;\r\n            color: var(--muted);\r\n        }\r\n\r\n        /* CATEGORIES */\r\n\r\n        .category-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 22px;\r\n        }\r\n\r\n        .category-card {\r\n            position: relative;\r\n            height: 430px;\r\n            border-radius: var(--radius);\r\n            overflow: hidden;\r\n            cursor: pointer;\r\n        }\r\n\r\n        .category-card img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n            transition: transform 0.5s ease;\r\n        }\r\n\r\n        .category-card:hover img {\r\n            transform: scale(1.06);\r\n        }\r\n\r\n        .category-overlay {\r\n            position: absolute;\r\n            inset: 0;\r\n            display: flex;\r\n            align-items: end;\r\n            padding: 28px;\r\n            background: linear-gradient(\r\n                transparent 40%,\r\n                rgba(0, 0, 0, 0.58)\r\n            );\r\n            color: white;\r\n        }\r\n\r\n        .category-overlay h3 {\r\n            font-size: 1.8rem;\r\n        }\r\n\r\n        /* PRODUCTS */\r\n\r\n        .products {\r\n            background: var(--surface-soft);\r\n        }\r\n\r\n        .product-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 20px;\r\n        }\r\n\r\n        .product-card {\r\n            background: var(--surface);\r\n            border-radius: var(--radius);\r\n            overflow: hidden;\r\n            border: 1px solid var(--border);\r\n            transition: 0.25s ease;\r\n        }\r\n\r\n        .product-card:hover {\r\n            transform: translateY(-7px);\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        .product-image {\r\n            position: relative;\r\n            height: 320px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .product-image img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n            transition: transform 0.4s ease;\r\n        }\r\n\r\n        .product-card:hover .product-image img {\r\n            transform: scale(1.05);\r\n        }\r\n\r\n        .badge {\r\n            position: absolute;\r\n            top: 14px;\r\n            left: 14px;\r\n            background: var(--primary);\r\n            color: white;\r\n            font-size: 0.72rem;\r\n            padding: 7px 10px;\r\n            border-radius: 999px;\r\n        }\r\n\r\n        .product-content {\r\n            padding: 20px;\r\n        }\r\n\r\n        .product-category {\r\n            color: var(--muted);\r\n            font-size: 0.8rem;\r\n        }\r\n\r\n        .product-content h3 {\r\n            margin: 6px 0 12px;\r\n            color: var(--primary);\r\n        }\r\n\r\n        .product-bottom {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 12px;\r\n        }\r\n\r\n        .price {\r\n            font-weight: 700;\r\n        }\r\n\r\n        .add-button {\r\n            border: none;\r\n            background: var(--primary);\r\n            color: white;\r\n            padding: 9px 14px;\r\n            border-radius: 999px;\r\n            transition: 0.2s ease;\r\n        }\r\n\r\n        .add-button:hover {\r\n            background: var(--primary-dark);\r\n        }\r\n\r\n        /* STORY */\r\n\r\n        .story-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 80px;\r\n            align-items: center;\r\n        }\r\n\r\n        .story-image {\r\n            height: 570px;\r\n            border-radius: 24px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .story-image img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n        }\r\n\r\n        .story-content h2 {\r\n            font-size: clamp(2.4rem, 4vw, 4.5rem);\r\n            line-height: 1;\r\n            letter-spacing: -2px;\r\n            color: var(--primary);\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .story-content > p {\r\n            color: var(--muted);\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .impact-list {\r\n            display: grid;\r\n            gap: 20px;\r\n        }\r\n\r\n        .impact-item {\r\n            display: flex;\r\n            gap: 16px;\r\n            padding: 18px;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .impact-number {\r\n            color: var(--accent);\r\n            font-size: 1.5rem;\r\n            font-weight: 800;\r\n            min-width: 55px;\r\n        }\r\n\r\n        .impact-item h4 {\r\n            color: var(--primary);\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n        .impact-item p {\r\n            color: var(--muted);\r\n            font-size: 0.92rem;\r\n        }\r\n\r\n        /* REVIEWS */\r\n\r\n        .reviews {\r\n            background: var(--primary);\r\n            color: white;\r\n        }\r\n\r\n        .reviews .section-header h2 {\r\n            color: white;\r\n        }\r\n\r\n        .reviews .section-header p {\r\n            color: rgba(255, 255, 255, 0.65);\r\n        }\r\n\r\n        .review-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 20px;\r\n        }\r\n\r\n        .review-card {\r\n            background: rgba(255, 255, 255, 0.08);\r\n            border: 1px solid rgba(255, 255, 255, 0.12);\r\n            padding: 28px;\r\n            border-radius: var(--radius);\r\n        }\r\n\r\n        .stars {\r\n            color: #e2b977;\r\n            margin-bottom: 18px;\r\n            letter-spacing: 3px;\r\n        }\r\n\r\n        .review-card p {\r\n            color: rgba(255, 255, 255, 0.8);\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .review-user strong {\r\n            display: block;\r\n        }\r\n\r\n        .review-user span {\r\n            color: rgba(255, 255, 255, 0.5);\r\n            font-size: 0.85rem;\r\n        }\r\n\r\n        /* NEWSLETTER */\r\n\r\n        .newsletter-box {\r\n            background: var(--surface);\r\n            border-radius: 24px;\r\n            padding: 60px;\r\n            box-shadow: var(--shadow);\r\n            text-align: center;\r\n        }\r\n\r\n        .newsletter-box h2 {\r\n            color: var(--primary);\r\n            font-size: clamp(2rem, 4vw, 3.5rem);\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        .newsletter-box p {\r\n            color: var(--muted);\r\n            max-width: 560px;\r\n            margin: auto;\r\n        }\r\n\r\n        .newsletter-form {\r\n            max-width: 600px;\r\n            margin: 30px auto 0;\r\n            display: flex;\r\n            gap: 10px;\r\n        }\r\n\r\n        .newsletter-form input {\r\n            flex: 1;\r\n            min-width: 0;\r\n            border: 1px solid var(--border);\r\n            padding: 15px 18px;\r\n            border-radius: 999px;\r\n            outline: none;\r\n        }\r\n\r\n        .newsletter-form input:focus {\r\n            border-color: var(--primary);\r\n        }\r\n\r\n        .newsletter-form button {\r\n            border: none;\r\n        }\r\n\r\n        /* FOOTER */\r\n\r\n        footer {\r\n            background: var(--primary-dark);\r\n            color: white;\r\n            padding: 70px 0 25px;\r\n        }\r\n\r\n        .footer-grid {\r\n            display: grid;\r\n            grid-template-columns: 2fr repeat(3, 1fr);\r\n            gap: 40px;\r\n            padding-bottom: 50px;\r\n        }\r\n\r\n        .footer-brand p {\r\n            color: rgba(255, 255, 255, 0.6);\r\n            max-width: 300px;\r\n            margin-top: 15px;\r\n        }\r\n\r\n        .footer-column h4 {\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .footer-column a {\r\n            display: block;\r\n            color: rgba(255, 255, 255, 0.6);\r\n            margin-bottom: 10px;\r\n            font-size: 0.9rem;\r\n        }\r\n\r\n        .footer-column a:hover {\r\n            color: white;\r\n        }\r\n\r\n        .footer-bottom {\r\n            border-top: 1px solid rgba(255, 255, 255, 0.12);\r\n            padding-top: 25px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            gap: 20px;\r\n            color: rgba(255, 255, 255, 0.5);\r\n            font-size: 0.85rem;\r\n        }\r\n\r\n        /* CART TOAST */\r\n\r\n        .toast {\r\n            position: fixed;\r\n            right: 25px;\r\n            bottom: 25px;\r\n            background: var(--primary);\r\n            color: white;\r\n            padding: 15px 22px;\r\n            border-radius: 12px;\r\n            box-shadow: var(--shadow);\r\n            transform: translateY(120px);\r\n            opacity: 0;\r\n            transition: 0.3s ease;\r\n            z-index: 2000;\r\n        }\r\n\r\n        .toast.show {\r\n            transform: translateY(0);\r\n            opacity: 1;\r\n        }\r\n\r\n        /* RESPONSIVE */\r\n\r\n        @media (max-width: 1000px) {\r\n            .hero,\r\n            .story-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .hero {\r\n                padding-top: 40px;\r\n            }\r\n\r\n            .hero-image {\r\n                height: 500px;\r\n            }\r\n\r\n            .product-grid {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .footer-grid {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .category-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .category-card {\r\n                height: 380px;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .nav-links {\r\n                position: fixed;\r\n                top: 76px;\r\n                left: 0;\r\n                right: 0;\r\n                background: var(--background);\r\n                border-bottom: 1px solid var(--border);\r\n                flex-direction: column;\r\n                padding: 30px;\r\n                transform: translateY(-150%);\r\n                opacity: 0;\r\n                pointer-events: none;\r\n                transition: 0.3s ease;\r\n            }\r\n\r\n            .nav-links.active {\r\n                transform: translateY(0);\r\n                opacity: 1;\r\n                pointer-events: auto;\r\n            }\r\n\r\n            .menu-button {\r\n                display: block;\r\n            }\r\n\r\n            .cart-button {\r\n                padding: 9px 12px;\r\n            }\r\n\r\n            .hero {\r\n                min-height: auto;\r\n                gap: 45px;\r\n            }\r\n\r\n            .hero h1 {\r\n                letter-spacing: -2px;\r\n            }\r\n\r\n            .hero-image {\r\n                height: 420px;\r\n            }\r\n\r\n            .floating-card {\r\n                left: 15px;\r\n                bottom: 15px;\r\n            }\r\n\r\n            .hero-stats {\r\n                gap: 20px;\r\n            }\r\n\r\n            .section-header {\r\n                align-items: start;\r\n                flex-direction: column;\r\n            }\r\n\r\n            .product-grid,\r\n            .review-grid,\r\n            .footer-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .newsletter-box {\r\n                padding: 40px 22px;\r\n            }\r\n\r\n            .newsletter-form {\r\n                flex-direction: column;\r\n            }\r\n\r\n            .newsletter-form button {\r\n                width: 100%;\r\n            }\r\n\r\n            .footer-bottom {\r\n                flex-direction: column;\r\n            }\r\n\r\n            .trust-content {\r\n                align-items: flex-start;\r\n                flex-direction: column;\r\n            }\r\n\r\n            .trust-brands {\r\n                gap: 18px;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n    <header id=\"header\">\r\n        <div class=\"container navbar\">\r\n\r\n            <a href=\"#home\" class=\"logo\">VERDE</a>\r\n\r\n            <nav class=\"nav-links\" id=\"navLinks\">\r\n                <a href=\"#collections\">Collections</a>\r\n                <a href=\"#products\">Shop</a>\r\n                <a href=\"#story\">Our Story</a>\r\n                <a href=\"#reviews\">Reviews</a>\r\n            </nav>\r\n\r\n            <div class=\"nav-actions\">\r\n                <button class=\"cart-button\" id=\"cartButton\">\r\n                    Cart\r\n                    <span class=\"cart-count\" id=\"cartCount\">0</span>\r\n                </button>\r\n\r\n                <button class=\"menu-button\" id=\"menuButton\">\r\n                    Menu\r\n                </button>\r\n            </div>\r\n\r\n        </div>\r\n    </header>\r\n\r\n    <main>\r\n\r\n        <section class=\"container hero\" id=\"home\">\r\n\r\n            <div class=\"hero-content\">\r\n\r\n                <span class=\"eyebrow\">\r\n                    Conscious fashion for modern living\r\n                </span>\r\n\r\n                <h1>\r\n                    Wear less.<br>\r\n                    Choose better.\r\n                </h1>\r\n\r\n                <p>\r\n                    Timeless essentials designed with natural materials,\r\n                    thoughtful craftsmanship, and a lighter impact on the planet.\r\n                </p>\r\n\r\n                <div class=\"hero-actions\">\r\n                    <a href=\"#products\" class=\"primary-button\">\r\n                        Shop the collection\r\n                    </a>\r\n\r\n                    <a href=\"#story\" class=\"secondary-button\">\r\n                        Discover VERDE\r\n                    </a>\r\n                </div>\r\n\r\n                <div class=\"hero-stats\">\r\n\r\n                    <div class=\"hero-stat\">\r\n                        <strong>100%</strong>\r\n                        <span>Responsible materials</span>\r\n                    </div>\r\n\r\n                    <div class=\"hero-stat\">\r\n                        <strong>42%</strong>\r\n                        <span>Less water used</span>\r\n                    </div>\r\n\r\n                    <div class=\"hero-stat\">\r\n                        <strong>0</strong>\r\n                        <span>Single-use plastic</span>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"hero-visual\">\r\n\r\n                <div class=\"hero-image\">\r\n                    <img\r\n                        src=\"https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=85\"\r\n                        alt=\"Modern sustainable fashion\"\r\n                    >\r\n                </div>\r\n\r\n                <div class=\"floating-card\">\r\n                    <s