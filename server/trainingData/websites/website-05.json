  "output": {
    "message": "A premium modern responsive website with interactive functionality.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>VELORA — Luxury Real Estate</title>\r\n\r\n  <style>\r\n    :root {\r\n      --bg: #f6f4ef;\r\n      --surface: #ffffff;\r\n      --dark: #171a18;\r\n      --muted: #6f746f;\r\n      --accent: #9a7654;\r\n      --accent-dark: #765637;\r\n      --border: #dedbd4;\r\n      --success: #4d7c5b;\r\n    }\r\n\r\n    * {\r\n      box-sizing: border-box;\r\n      margin: 0;\r\n      padding: 0;\r\n    }\r\n\r\n    html {\r\n      scroll-behavior: smooth;\r\n    }\r\n\r\n    body {\r\n      font-family: Arial, Helvetica, sans-serif;\r\n      background: var(--bg);\r\n      color: var(--dark);\r\n      line-height: 1.6;\r\n    }\r\n\r\n    a {\r\n      color: inherit;\r\n      text-decoration: none;\r\n    }\r\n\r\n    button,\r\n    input,\r\n    select {\r\n      font: inherit;\r\n    }\r\n\r\n    .container {\r\n      width: min(1180px, 92%);\r\n      margin: auto;\r\n    }\r\n\r\n    /* NAVBAR */\r\n\r\n    nav {\r\n      position: sticky;\r\n      top: 0;\r\n      z-index: 100;\r\n      background: rgba(246, 244, 239, 0.95);\r\n      border-bottom: 1px solid var(--border);\r\n      backdrop-filter: blur(12px);\r\n    }\r\n\r\n    .nav-inner {\r\n      min-height: 76px;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: space-between;\r\n      gap: 30px;\r\n    }\r\n\r\n    .logo {\r\n      font-size: 1.35rem;\r\n      font-weight: 800;\r\n      letter-spacing: 0.18em;\r\n    }\r\n\r\n    .nav-links {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 28px;\r\n    }\r\n\r\n    .nav-links a {\r\n      color: var(--muted);\r\n      font-size: 0.94rem;\r\n      transition: 0.2s;\r\n    }\r\n\r\n    .nav-links a:hover {\r\n      color: var(--dark);\r\n    }\r\n\r\n    .nav-button {\r\n      background: var(--dark);\r\n      color: white !important;\r\n      padding: 11px 18px;\r\n      border-radius: 6px;\r\n    }\r\n\r\n    /* HERO */\r\n\r\n    .hero {\r\n      min-height: 650px;\r\n      display: grid;\r\n      grid-template-columns: 1.05fr 0.95fr;\r\n      align-items: center;\r\n      gap: 70px;\r\n      padding: 90px 0;\r\n    }\r\n\r\n    .eyebrow {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      gap: 10px;\r\n      color: var(--accent);\r\n      font-size: 0.78rem;\r\n      font-weight: bold;\r\n      letter-spacing: 0.15em;\r\n      text-transform: uppercase;\r\n      margin-bottom: 24px;\r\n    }\r\n\r\n    .eyebrow::before {\r\n      content: \"\";\r\n      width: 32px;\r\n      height: 1px;\r\n      background: var(--accent);\r\n    }\r\n\r\n    h1 {\r\n      font-family: Georgia, serif;\r\n      font-size: clamp(3.2rem, 7vw, 6.2rem);\r\n      line-height: 0.98;\r\n      letter-spacing: -0.055em;\r\n      font-weight: 500;\r\n      margin-bottom: 26px;\r\n    }\r\n\r\n    .hero p {\r\n      max-width: 570px;\r\n      color: var(--muted);\r\n      font-size: 1.08rem;\r\n      margin-bottom: 34px;\r\n    }\r\n\r\n    .hero-actions {\r\n      display: flex;\r\n      flex-wrap: wrap;\r\n      gap: 14px;\r\n    }\r\n\r\n    .btn {\r\n      border: none;\r\n      cursor: pointer;\r\n      padding: 14px 21px;\r\n      border-radius: 6px;\r\n      transition: 0.25s;\r\n      font-weight: 600;\r\n    }\r\n\r\n    .btn-primary {\r\n      background: var(--accent);\r\n      color: white;\r\n    }\r\n\r\n    .btn-primary:hover {\r\n      background: var(--accent-dark);\r\n      transform: translateY(-2px);\r\n    }\r\n\r\n    .btn-secondary {\r\n      background: transparent;\r\n      color: var(--dark);\r\n      border: 1px solid var(--border);\r\n    }\r\n\r\n    .btn-secondary:hover {\r\n      background: white;\r\n    }\r\n\r\n    .hero-visual {\r\n      position: relative;\r\n    }\r\n\r\n    .hero-image {\r\n      height: 560px;\r\n      border-radius: 10px;\r\n      background:\r\n        linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.35)),\r\n        url(\"https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80\")\r\n        center/cover;\r\n      box-shadow: 0 30px 70px rgba(0,0,0,0.12);\r\n    }\r\n\r\n    .property-card {\r\n      position: absolute;\r\n      left: -45px;\r\n      bottom: 35px;\r\n      width: min(330px, 90%);\r\n      background: white;\r\n      padding: 22px;\r\n      border-radius: 8px;\r\n      box-shadow: 0 25px 50px rgba(0,0,0,0.14);\r\n    }\r\n\r\n    .property-card small {\r\n      color: var(--muted);\r\n    }\r\n\r\n    .property-card h3 {\r\n      font-size: 1.25rem;\r\n      margin: 6px 0 15px;\r\n    }\r\n\r\n    .property-info {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      border-top: 1px solid var(--border);\r\n      padding-top: 14px;\r\n      color: var(--muted);\r\n      font-size: 0.85rem;\r\n    }\r\n\r\n    /* STATS */\r\n\r\n    .stats {\r\n      padding: 35px 0 80px;\r\n    }\r\n\r\n    .stats-grid {\r\n      display: grid;\r\n      grid-template-columns: repeat(4, 1fr);\r\n      border-top: 1px solid var(--border);\r\n      border-bottom: 1px solid var(--border);\r\n    }\r\n\r\n    .stat {\r\n      padding: 28px;\r\n      border-right: 1px solid var(--border);\r\n    }\r\n\r\n    .stat:last-child {\r\n      border-right: none;\r\n    }\r\n\r\n    .stat strong {\r\n      display: block;\r\n      font-family: Georgia, serif;\r\n      font-size: 2.4rem;\r\n      font-weight: 500;\r\n    }\r\n\r\n    .stat span {\r\n      color: var(--muted);\r\n      font-size: 0.9rem;\r\n    }\r\n\r\n    /* PROPERTIES */\r\n\r\n    section {\r\n      padding: 100px 0;\r\n    }\r\n\r\n    .section-heading {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: end;\r\n      gap: 30px;\r\n      margin-bottom: 45px;\r\n    }\r\n\r\n    h2 {\r\n      font-family: Georgia, serif;\r\n      font-size: clamp(2.5rem, 5vw, 4.5rem);\r\n      font-weight: 500;\r\n      letter-spacing: -0.04em;\r\n      line-height: 1;\r\n    }\r\n\r\n    .section-heading p {\r\n      max-width: 430px;\r\n      color: var(--muted);\r\n    }\r\n\r\n    .properties {\r\n      background: #eeeae3;\r\n    }\r\n\r\n    .property-grid {\r\n      display: grid;\r\n      grid-template-columns: repeat(3, 1fr);\r\n      gap: 22px;\r\n    }\r\n\r\n    .property {\r\n      background: white;\r\n      border-radius: 8px;\r\n      overflow: hidden;\r\n      transition: transform 0.25s, box-shadow 0.25s;\r\n    }\r\n\r\n    .property:hover {\r\n      transform: translateY(-7px);\r\n      box-shadow: 0 22px 45px rgba(0,0,0,0.1);\r\n    }\r\n\r\n    .property-image {\r\n      height: 260px;\r\n      background-size: cover;\r\n      background-position: center;\r\n    }\r\n\r\n    .property:nth-child(1) .property-image {\r\n      background-image: url(\"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=900&q=80\");\r\n    }\r\n\r\n    .property:nth-child(2) .property-image {\r\n      background-image: url(\"https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=900&q=80\");\r\n    }\r\n\r\n    .property:nth-child(3) .property-image {\r\n      background-image: url(\"https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&w=900&q=80\");\r\n    }\r\n\r\n    .property-content {\r\n      padding: 22px;\r\n    }\r\n\r\n    .property-content small {\r\n      color: var(--accent);\r\n      text-transform: uppercase;\r\n      letter-spacing: 0.08em;\r\n    }\r\n\r\n    .property-content h3 {\r\n      font-size: 1.25rem;\r\n      margin: 8px 0;\r\n    }\r\n\r\n    .property-content p {\r\n      color: var(--muted);\r\n      font-size: 0.92rem;\r\n    }\r\n\r\n    .price {\r\n      display: block;\r\n      margin-top: 18px;\r\n      font-weight: bold;\r\n      font-size: 1.1rem;\r\n    }\r\n\r\n    /* ABOUT */\r\n\r\n    .about {\r\n      display: grid;\r\n      grid-template-columns: 0.9fr 1.1fr;\r\n      gap: 80px;\r\n      align-items: center;\r\n    }\r\n\r\n    .about-image {\r\n      min-height: 530px;\r\n      border-radius: 8px;\r\n      background:\r\n        url(\"https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=80\")\r\n        center/cover;\r\n    }\r\n\r\n    .about-content p {\r\n      color: var(--muted);\r\n      margin: 25px 0;\r\n      font-size: 1.05rem;\r\n    }\r\n\r\n    .features {\r\n      display: grid;\r\n      grid-template-columns: 1fr 1fr;\r\n      gap: 22px;\r\n      margin-top: 35px;\r\n    }\r\n\r\n    .feature {\r\n      border-top: 1px solid var(--border);\r\n      padding-top: 16px;\r\n    }\r\n\r\n    .feature strong {\r\n      display: block;\r\n      margin-bottom: 6px;\r\n    }\r\n\r\n    .feature span {\r\n      color: var(--muted);\r\n      font-size: 0.9rem;\r\n    }\r\n\r\n    /* CONTACT */\r\n\r\n    .contact {\r\n      background: var(--dark);\r\n      color: white;\r\n    }\r\n\r\n    .contact-grid {\r\n      display: grid;\r\n      grid-template-columns: 1fr 1fr;\r\n      gap: 80px;\r\n      align-items: start;\r\n    }\r\n\r\n    .contact p {\r\n      color: #b7bdb8;\r\n      margin-top: 20px;\r\n      max-width: 480px;\r\n    }\r\n\r\n    form {\r\n      display: grid;\r\n      gap: 15px;\r\n    }\r\n\r\n    input,\r\n    select,\r\n    textarea {\r\n      width: 100%;\r\n      border: 1px solid #444944;\r\n      background: #202421;\r\n      color: white;\r\n      padding: 15px;\r\n      border-radius: 5px;\r\n      outline: none;\r\n    }\r\n\r\n    textarea {\r\n      min-height: 120px;\r\n      resize: vertical;\r\n    }\r\n\r\n    .form-message {\r\n      display: none;\r\n      margin-top: 10px;\r\n      color: #8cc69b;\r\n    }\r\n\r\n    /* FOOTER */\r\n\r\n    footer {\r\n      background: #101210;\r\n      color: #a6ada7;\r\n      padding: 28px 0;\r\n    }\r\n\r\n    .footer-inner {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      gap: 20px;\r\n      flex-wrap: wrap;\r\n      font-size: 0.88rem;\r\n    }\r\n\r\n    /* MOBILE */\r\n\r\n    @media (max-width: 850px) {\r\n      .nav-links {\r\n        display: none;\r\n      }\r\n\r\n      .hero,\r\n      .about,\r\n      .contact-grid {\r\n        grid-template-columns: 1fr;\r\n      }\r\n\r\n      .hero {\r\n        gap: 45px;\r\n        padding: 70px 0;\r\n      }\r\n\r\n      .hero-image {\r\n        height: 480px;\r\n      }\r\n\r\n      .property-card {\r\n        left: 20px;\r\n      }\r\n\r\n      .stats-grid {\r\n        grid-template-columns: repeat(2, 1fr);\r\n      }\r\n\r\n      .stat:nth-child(2) {\r\n        border-right: none;\r\n      }\r\n\r\n      .stat:nth-child(-n+2) {\r\n        border-bottom: 1px solid var(--border);\r\n      }\r\n\r\n      .property-grid {\r\n        grid-template-columns: 1fr;\r\n      }\r\n\r\n      .section-heading {\r\n        align-items: start;\r\n        flex-direction: column;\r\n      }\r\n\r\n      .about {\r\n        gap: 45px;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 520px) {\r\n      .hero-image {\r\n        height: 400px;\r\n      }\r\n\r\n      .stats-grid {\r\n        grid-template-columns: 1fr;\r\n      }\r\n\r\n      .stat {\r\n        border-right: none;\r\n        border-bottom: 1px solid var(--border);\r\n      }\r\n\r\n      .stat:last-child {\r\n        border-bottom: none;\r\n      }\r\n\r\n      .features {\r\n        grid-template-columns: 1fr;\r\n      }\r\n\r\n      section {\r\n        padding: 75px 0;\r\n      }\r\n    }\r\n  </style>\r\n</head>\r\n\r\n<body>\r\n\r\n  <nav>\r\n    <div class=\"container nav-inner\">\r\n      <a href=\"#home\" class=\"logo\">VELORA</a>\r\n\r\n      <div class=\"nav-links\">\r\n        <a href=\"#properties\">Properties</a>\r\n        <a href=\"#about\">About</a>\r\n        <a href=\"#contact\">Contact</a>\r\n        <a href=\"#contact\" class=\"nav-button\">Book a Viewing</a>\r\n      </div>\r\n    </div>\r\n  </nav>\r\n\r\n  <main>\r\n\r\n    <section class=\"hero container\" id=\"home\">\r\n      <div>\r\n        <div class=\"eyebrow\">Private Real Estate</div>\r\n\r\n        <h1>Extraordinary homes for exceptional lives.</h1>\r\n\r\n        <p>\r\n          Velora connects discerning buyers with remarkable properties,\r\n          private residences, and distinctive homes in the world's most\r\n          desirable locations.\r\n        </p>\r\n\r\n        <div class=\"hero-actions\">\r\n          <a href=\"#properties\" class=\"btn btn-primary\">Explore Properties</a>\r\n          <a href=\"#contact\" class=\"btn btn-secondary\">Speak With an Advisor</a>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"hero-visual\">\r\n        <div class=\"hero-image\"></div>\r\n\r\n        <div class=\"property-card\">\r\n          <small>Featured Residence</small>\r\n          <h3>Coastal Modern Estate</h3>\r\n\r\n          <div class=\"property-info\">\r\n            <span>4 Bedrooms</span>\r\n            <span>5 Bathrooms</span>\r\n            <span>4,850 sq ft</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"stats\">\r\n      <div class=\"container stats-grid\">\r\n        <div class=\"stat\">\r\n          <strong>$4.2B+</strong>\r\n          <span>Property value represented</span>\r\n        </div>\r\n\r\n        <div class=\"stat\">\r\n          <strong>18</strong>\r\n          <span>Global markets</span>\r\n        </div>\r\n\r\n        <div class=\"stat\">\r\n          <strong>96%</strong>\r\n          <span>Client referral rate</span>\r\n        </div>\r\n\r\n        <div class=\"stat\">\r\n          <strong>24/7</strong>\r\n          <span>Private client support</span>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"properties\" id=\"properties\">\r\n      <div class=\"container\">\r\n\r\n        <div class=\"section-heading\">\r\n          <div>\r\n            <div class=\"eyebrow\">Curated Collection</div>\r\n            <h2>Featured properties.</h2>\r\n          </div>\r\n\r\n          <p>\r\n            A considered collection of residences selected for their\r\n            architecture, location, privacy, and long-term value.\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"property-grid\">\r\n\r\n          <article class=\"property\">\r\n            <div class=\"property-image\"></div>\r\n\r\n            <div class=\"property-content\">\r\n              <small>Malibu, California</small>\r\n              <h3>Pacific Ridge Residence</h3>\r\n              <p>5 bedrooms · 6 bathrooms · 6,200 sq ft</p>\r\n              <span class=\"price\">$8,950,000</span>\r\n            </div>\r\n          </article>\r\n\r\n          <article class=\"property\">\r\n            <div class=\"property-image\"></div>\r\n\r\n            <div class=\"property-content\">\r\n              <small>Austin, Texas</small>\r\n              <h3>Hill Country Retreat</h3>\r\n              <p>4 bedrooms · 5 bathrooms · 4,600 sq ft</p>\r\n              <span class=\"price\">$3,750,000</span>\r\n            </div>\r\n          </article>\r\n\r\n          <article class=\"property\">\r\n            <div class=\"property-image\"></div>\r\n\r\n            <div class=\"property-content\">\r\n              <small>Miami, Florida</small>\r\n              <h3>Bayfront Villa</h3>\r\n              <p>6 bedrooms · 7 bathrooms · 7,100 sq ft</p>\r\n              <span class=\"price\">$12,400,000</span>\r\n            </div>\r\n          </article>\r\n\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section id=\"about\">\r\n      <div class=\"container about\">\r\n\r\n        <div class=\"about-image\"></div>\r\n\r\n        <div class=\"about-content\">\r\n          <div class=\"eyebrow\">The Velora Difference</div>\r\n\r\n          <h2>Real estate, represented personally.</h2>\r\n\r\n          <p>\r\n            We combine local expertise, global reach, and a highly personal\r\n            approach to represent clients through every stage of their\r\n            property journey.\r\n          </p>\r\n\r\n          <p>\r\n            From private introductions to strategic negotiations, every\r\n            detail is handled with discretion and precision.\r\n          </p>\r\n\r\n          <div class=\"features\">\r\n\r\n            <div class=\"feature\">\r\n              <strong>Private Access</strong>\r\n              <span>Opportunities beyond public listings.</span>\r\n            </div>\r\n\r\n            <div class=\"feature\">\r\n              <strong>Global Network</strong>\r\n              <span>Connected expertise across key markets.</span>\r\n            </div>\r\n\r\n            <div class=\"feature\">\r\n              <strong>Strategic Advisory</strong>\r\n              <span>Guidance informed by market intelligence.</span>\r\n            </div>\r\n\r\n            <div class=\"feature\">\r\n              <strong>End-to-End Service</strong>\r\n              <span>Support from discovery through closing.</span>\r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"contact\" id=\"contact\">\r\n      <div class=\"container contact-grid\">\r\n\r\n        <div>\r\n          <div class=\"eyebrow\">Private Consultation</div>\r\n          <h2>Let's find your next extraordinary home.</h2>\r\n\r\n          <p>\r\n            Tell us what you are looking for and one of our advisors will\r\n            contact you to begin a private consultation.\r\n          </p>\r\n        </div>\r\n\r\n        <div>\r\n          <form id=\"contactForm\">\r\n\r\n            <input\r\n              type=\"text\"\r\n              id=\"name\"\r\n              placeholder=\"Your name\"\r\n              required\r\n            >\r\n\r\n            <input\r\n              type=\"email\"\r\n              id=\"email\"\r\n              placeholder=\"Email address\"\r\n              required\r\n            >\r\n\r\n            <select id=\"interest\" required>\r\n              <option value=\"\">I'm interested in...</option>\r\n              <option>Buying a property</option>\r\n              <option>Selling a property</option>\r\n              <option>Private investment</option>\r\n              <option>Market consultation</option>\r\n            </select>\r\n\r\n            <textarea\r\n              id=\"message\"\r\n              placeholder=\"Tell us more about your requirements\"\r\n            ></textarea>\r\n\r\n            <button type=\"submit\" class=\"btn btn-primary\">\r\n              Request Consultation\r\n            </button>\r\n\r\n          </form>\r\n\r\n          <div class=\"form-message\" id=\"formMessage\">\r\n            Thank you. Your consultation request has been received.\r\n          </div>\r\n        </div>\r\n\r\n      </div>\r\n    </section>\r\n\r\n  </main>\r\n\r\n  <footer>\r\n    <div class=\"container footer-inner\">\r\n      <span>© <span id=\"year\"></span> Velora Real Estate. All rights reserved.</span>\r\n      <span>Private real estate advisory</span>\r\n    </div>\r\n  </footer>\r\n\r\n  <script>\r\n    document.getElementById(\"year\").textContent =\r\n      new Date().getFullYear();\r\n\r\n    const form = document.getElementById(\"contactForm\");\r\n    const formMessage = document.getElementById(\"formMessage\");\r\n\r\n    form.addEventListener(\"submit\", function (event) {\r\n      event.preventDefault();\r\n\r\n      form.reset();\r\n      formMessage.style.display = \"block\";\r\n\r\n      setTimeout(function () {\r\n        formMessage.style.display = \"none\";\r\n      }, 5000);\r\n    });\r\n  </script>\r\n\r\n</body>\r\n</html>"
  }
