    "message": "A premium modern creative design agency website.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>ÉLAN — Modern Luxury Fashion</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #111111;\r\n            --accent: #b08d57;\r\n            --background: #f7f5f1;\r\n            --surface: #ffffff;\r\n            --text-primary: #111111;\r\n            --text-secondary: #666666;\r\n            --border: #e5e2dc;\r\n            --success: #2f7d4b;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        html {\r\n            scroll-behavior: smooth;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, Helvetica, sans-serif;\r\n            background: var(--background);\r\n            color: var(--text-primary);\r\n            line-height: 1.5;\r\n        }\r\n\r\n        a {\r\n            color: inherit;\r\n            text-decoration: none;\r\n        }\r\n\r\n        button {\r\n            font: inherit;\r\n            cursor: pointer;\r\n        }\r\n\r\n        /* NAVBAR */\r\n\r\n        .navbar {\r\n            height: 78px;\r\n            padding: 0 6%;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            background: rgba(247, 245, 241, 0.95);\r\n            border-bottom: 1px solid var(--border);\r\n            position: sticky;\r\n            top: 0;\r\n            z-index: 100;\r\n        }\r\n\r\n        .logo {\r\n            font-size: 1.5rem;\r\n            font-weight: 800;\r\n            letter-spacing: 5px;\r\n        }\r\n\r\n        .nav-links {\r\n            display: flex;\r\n            gap: 32px;\r\n            list-style: none;\r\n        }\r\n\r\n        .nav-links a {\r\n            color: var(--text-secondary);\r\n            font-size: 0.92rem;\r\n            transition: 0.25s;\r\n        }\r\n\r\n        .nav-links a:hover {\r\n            color: var(--primary);\r\n        }\r\n\r\n        .nav-actions {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 18px;\r\n        }\r\n\r\n        .icon-btn {\r\n            background: transparent;\r\n            border: none;\r\n            color: var(--primary);\r\n            position: relative;\r\n            font-size: 1rem;\r\n        }\r\n\r\n        .cart-count {\r\n            position: absolute;\r\n            top: -10px;\r\n            right: -12px;\r\n            width: 18px;\r\n            height: 18px;\r\n            border-radius: 50%;\r\n            background: var(--accent);\r\n            color: white;\r\n            font-size: 0.7rem;\r\n            display: grid;\r\n            place-items: center;\r\n        }\r\n\r\n        .menu-btn {\r\n            display: none;\r\n            border: none;\r\n            background: transparent;\r\n            font-size: 1.4rem;\r\n        }\r\n\r\n        /* HERO */\r\n\r\n        .hero {\r\n            min-height: 680px;\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            align-items: center;\r\n            padding: 70px 6%;\r\n            gap: 60px;\r\n        }\r\n\r\n        .hero-content span {\r\n            color: var(--accent);\r\n            font-size: 0.8rem;\r\n            font-weight: 700;\r\n            letter-spacing: 3px;\r\n        }\r\n\r\n        .hero-content h1 {\r\n            font-size: clamp(3.5rem, 7vw, 7rem);\r\n            line-height: 0.95;\r\n            margin: 22px 0;\r\n            letter-spacing: -3px;\r\n        }\r\n\r\n        .hero-content p {\r\n            max-width: 540px;\r\n            color: var(--text-secondary);\r\n            font-size: 1.05rem;\r\n            margin-bottom: 35px;\r\n        }\r\n\r\n        .hero-buttons {\r\n            display: flex;\r\n            gap: 15px;\r\n            flex-wrap: wrap;\r\n        }\r\n\r\n        .btn {\r\n            border: 1px solid var(--primary);\r\n            padding: 15px 27px;\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            transition: 0.25s;\r\n            font-size: 0.9rem;\r\n        }\r\n\r\n        .btn-primary {\r\n            background: var(--primary);\r\n            color: white;\r\n        }\r\n\r\n        .btn-primary:hover {\r\n            transform: translateY(-3px);\r\n            background: #333;\r\n        }\r\n\r\n        .btn-outline:hover {\r\n            background: var(--primary);\r\n            color: white;\r\n        }\r\n\r\n        .hero-visual {\r\n            min-height: 560px;\r\n            overflow: hidden;\r\n            position: relative;\r\n            background:\r\n                linear-gradient(\r\n                    rgba(0, 0, 0, 0.05),\r\n                    rgba(0, 0, 0, 0.15)\r\n                ),\r\n                url(\"https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=80\")\r\n                center/cover;\r\n        }\r\n\r\n        .hero-label {\r\n            position: absolute;\r\n            bottom: 25px;\r\n            left: 25px;\r\n            background: rgba(255,255,255,0.92);\r\n            padding: 15px 20px;\r\n            max-width: 230px;\r\n        }\r\n\r\n        .hero-label strong {\r\n            display: block;\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n        .hero-label p {\r\n            font-size: 0.8rem;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        /* TRUST */\r\n\r\n        .trust {\r\n            border-top: 1px solid var(--border);\r\n            border-bottom: 1px solid var(--border);\r\n            padding: 25px 6%;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            gap: 20px;\r\n            flex-wrap: wrap;\r\n            color: var(--text-secondary);\r\n            font-size: 0.85rem;\r\n        }\r\n\r\n        /* SECTION */\r\n\r\n        section {\r\n            padding: 100px 6%;\r\n        }\r\n\r\n        .section-header {\r\n            display: flex;\r\n            align-items: end;\r\n            justify-content: space-between;\r\n            gap: 30px;\r\n            margin-bottom: 45px;\r\n        }\r\n\r\n        .eyebrow {\r\n            color: var(--accent);\r\n            font-size: 0.75rem;\r\n            font-weight: 700;\r\n            letter-spacing: 2px;\r\n            text-transform: uppercase;\r\n            margin-bottom: 12px;\r\n        }\r\n\r\n        .section-header h2 {\r\n            font-size: clamp(2rem, 4vw, 4rem);\r\n            line-height: 1;\r\n            letter-spacing: -2px;\r\n        }\r\n\r\n        .section-header p {\r\n            max-width: 430px;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        /* COLLECTIONS */\r\n\r\n        .collections {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 20px;\r\n        }\r\n\r\n        .collection-card {\r\n            min-height: 430px;\r\n            position: relative;\r\n            overflow: hidden;\r\n            display: flex;\r\n            align-items: end;\r\n            padding: 30px;\r\n            color: white;\r\n            background-size: cover;\r\n            background-position: center;\r\n            transition: transform 0.3s;\r\n        }\r\n\r\n        .collection-card:hover {\r\n            transform: translateY(-6px);\r\n        }\r\n\r\n        .collection-card::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            inset: 0;\r\n            background: linear-gradient(\r\n                transparent,\r\n                rgba(0,0,0,0.75)\r\n            );\r\n        }\r\n\r\n        .collection-content {\r\n            position: relative;\r\n            z-index: 1;\r\n        }\r\n\r\n        .collection-content h3 {\r\n            font-size: 2rem;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .collection-1 {\r\n            background-image:\r\n                url(\"https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80\");\r\n        }\r\n\r\n        .collection-2 {\r\n            background-image:\r\n                url(\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80\");\r\n        }\r\n\r\n        .collection-3 {\r\n            background-image:\r\n                url(\"https://images.unsplash.com/photo-1485230895905-ec40ba36b9bc?auto=format&fit=crop&w=900&q=80\");\r\n        }\r\n\r\n        /* PRODUCTS */\r\n\r\n        .product-toolbar {\r\n            display: flex;\r\n            gap: 12px;\r\n            flex-wrap: wrap;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .filter-btn {\r\n            background: transparent;\r\n            border: 1px solid var(--border);\r\n            padding: 10px 18px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .filter-btn.active,\r\n        .filter-btn:hover {\r\n            background: var(--primary);\r\n            color: white;\r\n            border-color: var(--primary);\r\n        }\r\n\r\n        .products {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 22px;\r\n        }\r\n\r\n        .product-card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            transition: 0.25s;\r\n        }\r\n\r\n        .product-card:hover {\r\n            transform: translateY(-6px);\r\n            box-shadow: 0 20px 45px rgba(0,0,0,0.08);\r\n        }\r\n\r\n        .product-image {\r\n            aspect-ratio: 3 / 4;\r\n            background-size: cover;\r\n            background-position: center;\r\n            position: relative;\r\n        }\r\n\r\n        .product-tag {\r\n            position: absolute;\r\n            top: 15px;\r\n            left: 15px;\r\n            background: white;\r\n            color: var(--primary);\r\n            padding: 6px 10px;\r\n            font-size: 0.7rem;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .product-info {\r\n            padding: 20px;\r\n        }\r\n\r\n        .product-category {\r\n            color: var(--text-secondary);\r\n            font-size: 0.75rem;\r\n            margin-bottom: 5px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        .product-info h3 {\r\n            font-size: 1rem;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .product-bottom {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 10px;\r\n        }\r\n\r\n        .price {\r\n            font-weight: 700;\r\n        }\r\n\r\n        .add-cart {\r\n            border: none;\r\n            background: var(--primary);\r\n            color: white;\r\n            padding: 9px 13px;\r\n            font-size: 0.75rem;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .add-cart:hover {\r\n            background: var(--accent);\r\n        }\r\n\r\n        /* STORY */\r\n\r\n        .story {\r\n            background: var(--primary);\r\n            color: white;\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 70px;\r\n            align-items: center;\r\n        }\r\n\r\n        .story-image {\r\n            min-height: 500px;\r\n            background:\r\n                url(\"https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1200&q=80\")\r\n                center/cover;\r\n        }\r\n\r\n        .story-content .eyebrow {\r\n            color: var(--accent);\r\n        }\r\n\r\n        .story-content h2 {\r\n            font-size: clamp(2.5rem, 5vw, 5rem);\r\n            line-height: 1;\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .story-content p {\r\n            color: #bcbcbc;\r\n            max-width: 500px;\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .story-content .btn-outline {\r\n            color: white;\r\n            border-color: #555;\r\n        }\r\n\r\n        .story-content .btn-outline:hover {\r\n            background: white;\r\n            color: black;\r\n        }\r\n\r\n        /* NEWSLETTER */\r\n\r\n        .newsletter {\r\n            text-align: center;\r\n            max-width: 800px;\r\n            margin: auto;\r\n        }\r\n\r\n        .newsletter h2 {\r\n            font-size: clamp(2.5rem, 5vw, 4.5rem);\r\n            letter-spacing: -2px;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        .newsletter p {\r\n            color: var(--text-secondary);\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .newsletter-form {\r\n            display: flex;\r\n            max-width: 600px;\r\n            margin: auto;\r\n        }\r\n\r\n        .newsletter-form input {\r\n            flex: 1;\r\n            padding: 16px;\r\n            border: 1px solid var(--border);\r\n            background: white;\r\n            outline: none;\r\n        }\r\n\r\n        .newsletter-form button {\r\n            padding: 16px 25px;\r\n            border: 1px solid var(--primary);\r\n            background: var(--primary);\r\n            color: white;\r\n        }\r\n\r\n        /* FOOTER */\r\n\r\n        footer {\r\n            background: var(--primary);\r\n            color: white;\r\n            padding: 70px 6% 30px;\r\n        }\r\n\r\n        .footer-grid {\r\n            display: grid;\r\n            grid-template-columns: 2fr repeat(3, 1fr);\r\n            gap: 50px;\r\n            margin-bottom: 60px;\r\n        }\r\n\r\n        .footer-brand p {\r\n            color: #aaa;\r\n            max-width: 300px;\r\n            margin-top: 18px;\r\n        }\r\n\r\n        .footer-column h4 {\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .footer-column a {\r\n            display: block;\r\n            color: #aaa;\r\n            margin-bottom: 10px;\r\n            font-size: 0.9rem;\r\n        }\r\n\r\n        .footer-bottom {\r\n            border-top: 1px solid #333;\r\n            padding-top: 25px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            color: #888;\r\n            font-size: 0.85rem;\r\n        }\r\n\r\n        /* MOBILE */\r\n\r\n        @media (max-width: 900px) {\r\n            .hero,\r\n            .story {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .collections {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .products {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .footer-grid {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .nav-links {\r\n                display: none;\r\n                position: absolute;\r\n                top: 78px;\r\n                left: 0;\r\n                width: 100%;\r\n                background: var(--background);\r\n                flex-direction: column;\r\n                padding: 25px 6%;\r\n                border-bottom: 1px solid var(--border);\r\n            }\r\n\r\n            .nav-links.active {\r\n                display: flex;\r\n            }\r\n\r\n            .menu-btn {\r\n                display: block;\r\n            }\r\n\r\n            .hero {\r\n                padding-top: 50px;\r\n            }\r\n\r\n            .hero-visual {\r\n                min-height: 420px;\r\n            }\r\n\r\n            .products {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .section-header {\r\n                display: block;\r\n            }\r\n\r\n            .section-header p {\r\n                margin-top: 20px;\r\n            }\r\n\r\n            .newsletter-form {\r\n                flex-direction: column;\r\n                gap: 10px;\r\n            }\r\n\r\n            .footer-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .footer-bottom {\r\n                flex-direction: column;\r\n                gap: 10px;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n    <header class=\"navbar\">\r\n        <a href=\"#home\" class=\"logo\">ÉLAN</a>\r\n\r\n        <ul class=\"nav-links\" id=\"navLinks\">\r\n            <li><a href=\"#collections\">Collections</a></li>\r\n            <li><a href=\"#shop\">Shop</a></li>\r\n            <li><a href=\"#story\">Our Story</a></li>\r\n            <li><a href=\"#newsletter\">Journal</a></li>\r\n        </ul>\r\n\r\n        <div class=\"nav-actions\">\r\n            <button class=\"icon-btn\" aria-label=\"Search\">⌕</button>\r\n\r\n            <button class=\"icon-btn\" aria-label=\"Shopping cart\">\r\n                Bag\r\n                <span class=\"cart-count\" id=\"cartCount\">0</span>\r\n            </button>\r\n\r\n            <button\r\n                class=\"menu-btn\"\r\n                id=\"menuBtn\"\r\n                aria-label=\"Open menu\"\r\n            >\r\n                ☰\r\n            </button>\r\n        </div>\r\n    </header>\r\n\r\n    <main>\r\n\r\n        <section class=\"hero\" id=\"home\">\r\n            <div class=\"hero-content\">\r\n                <span>THE NEW COLLECTION — 2026</span>\r\n\r\n                <h1>Dress the way you want to be remembered.</h1>\r\n\r\n                <p>\r\n                    Modern essentials, elevated tailoring and timeless\r\n                    silhouettes designed for a wardrobe that moves with you.\r\n                </p>\r\n\r\n                <div class=\"hero-buttons\">\r\n    