{
  "input": {
    "pageType": "dashboard",
    "prompt": "Create a premium modern sales analytics dashboard with revenue metrics, performance charts, recent orders, and customer insights."
  },
  "output": {
    "message": "A premium interactive sales analytics dashboard.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <title>Sales Analytics Dashboard</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #2563eb;\r\n            --primary-dark: #1d4ed8;\r\n            --success: #16a34a;\r\n            --danger: #dc2626;\r\n            --warning: #d97706;\r\n\r\n            --background: #f6f7fb;\r\n            --surface: #ffffff;\r\n            --surface-secondary: #f8fafc;\r\n\r\n            --text-primary: #172033;\r\n            --text-secondary: #667085;\r\n\r\n            --border: #e5e7eb;\r\n            --sidebar: #111827;\r\n            --sidebar-hover: #1f2937;\r\n\r\n            --shadow: 0 4px 20px rgba(15, 23, 42, 0.06);\r\n            --radius: 14px;\r\n        }\r\n\r\n        * {\r\n            box-sizing: border-box;\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        body {\r\n            font-family: Inter, Arial, sans-serif;\r\n            background: var(--background);\r\n            color: var(--text-primary);\r\n        }\r\n\r\n        button,\r\n        input {\r\n            font: inherit;\r\n        }\r\n\r\n        button {\r\n            border: none;\r\n            cursor: pointer;\r\n        }\r\n\r\n        .app {\r\n            min-height: 100vh;\r\n            display: flex;\r\n        }\r\n\r\n        /* SIDEBAR */\r\n\r\n        .sidebar {\r\n            width: 260px;\r\n            background: var(--sidebar);\r\n            color: white;\r\n            padding: 24px 16px;\r\n            display: flex;\r\n            flex-direction: column;\r\n            position: fixed;\r\n            inset: 0 auto 0 0;\r\n            transition: transform 0.3s ease;\r\n            z-index: 100;\r\n        }\r\n\r\n        .brand {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n            padding: 8px 12px 32px;\r\n            font-size: 20px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .brand-icon {\r\n            width: 38px;\r\n            height: 38px;\r\n            display: grid;\r\n            place-items: center;\r\n            background: var(--primary);\r\n            border-radius: 10px;\r\n        }\r\n\r\n        .nav-label {\r\n            font-size: 11px;\r\n            color: #9ca3af;\r\n            letter-spacing: 0.08em;\r\n            margin: 16px 12px 8px;\r\n        }\r\n\r\n        .nav-item {\r\n            width: 100%;\r\n            padding: 12px;\r\n            border-radius: 10px;\r\n            background: transparent;\r\n            color: #cbd5e1;\r\n            text-align: left;\r\n            margin-bottom: 4px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .nav-item:hover,\r\n        .nav-item.active {\r\n            background: var(--sidebar-hover);\r\n            color: white;\r\n        }\r\n\r\n        .nav-item.active {\r\n            border-left: 3px solid var(--primary);\r\n        }\r\n\r\n        .sidebar-bottom {\r\n            margin-top: auto;\r\n            padding-top: 20px;\r\n            border-top: 1px solid #374151;\r\n        }\r\n\r\n        .user-card {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n            padding: 10px;\r\n        }\r\n\r\n        .avatar {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 50%;\r\n            background: linear-gradient(135deg, #2563eb, #7c3aed);\r\n            display: grid;\r\n            place-items: center;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .user-info strong {\r\n            display: block;\r\n            font-size: 14px;\r\n        }\r\n\r\n        .user-info span {\r\n            font-size: 12px;\r\n            color: #9ca3af;\r\n        }\r\n\r\n        /* MAIN */\r\n\r\n        .main {\r\n            width: 100%;\r\n            margin-left: 260px;\r\n            padding: 28px;\r\n        }\r\n\r\n        .topbar {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 20px;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .topbar-left {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 16px;\r\n        }\r\n\r\n        .menu-button {\r\n            display: none;\r\n            width: 42px;\r\n            height: 42px;\r\n            border-radius: 10px;\r\n            background: var(--surface);\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        h1 {\r\n            font-size: 28px;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .subtitle {\r\n            color: var(--text-secondary);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .topbar-actions {\r\n            display: flex;\r\n            gap: 10px;\r\n            align-items: center;\r\n        }\r\n\r\n        .date-select,\r\n        .export-button {\r\n            padding: 11px 14px;\r\n            border-radius: 10px;\r\n            border: 1px solid var(--border);\r\n            background: var(--surface);\r\n        }\r\n\r\n        .export-button {\r\n            background: var(--primary);\r\n            color: white;\r\n        }\r\n\r\n        .export-button:hover {\r\n            background: var(--primary-dark);\r\n        }\r\n\r\n        /* METRICS */\r\n\r\n        .metrics-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 18px;\r\n            margin-bottom: 24px;\r\n        }\r\n\r\n        .metric-card {\r\n            background: var(--surface);\r\n            padding: 20px;\r\n            border: 1px solid var(--border);\r\n            border-radius: var(--radius);\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        .metric-header {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .metric-title {\r\n            color: var(--text-secondary);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .metric-icon {\r\n            width: 38px;\r\n            height: 38px;\r\n            display: grid;\r\n            place-items: center;\r\n            border-radius: 10px;\r\n            background: #eff6ff;\r\n        }\r\n\r\n        .metric-value {\r\n            font-size: 26px;\r\n            font-weight: 700;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .metric-change {\r\n            font-size: 13px;\r\n        }\r\n\r\n        .positive {\r\n            color: var(--success);\r\n        }\r\n\r\n        .negative {\r\n            color: var(--danger);\r\n        }\r\n\r\n        /* CONTENT GRID */\r\n\r\n        .content-grid {\r\n            display: grid;\r\n            grid-template-columns: 2fr 1fr;\r\n            gap: 24px;\r\n            margin-bottom: 24px;\r\n        }\r\n\r\n        .card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: var(--radius);\r\n            padding: 22px;\r\n            box-shadow: var(--shadow);\r\n        }\r\n\r\n        .card-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 24px;\r\n        }\r\n\r\n        .card-header h2 {\r\n            font-size: 17px;\r\n        }\r\n\r\n        .card-header span {\r\n            color: var(--text-secondary);\r\n            font-size: 13px;\r\n        }\r\n\r\n        /* BAR CHART */\r\n\r\n        .chart {\r\n            height: 280px;\r\n            display: flex;\r\n            align-items: end;\r\n            gap: 20px;\r\n            padding-top: 30px;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .bar-group {\r\n            flex: 1;\r\n            height: 100%;\r\n            display: flex;\r\n            align-items: end;\r\n            justify-content: center;\r\n            gap: 7px;\r\n            position: relative;\r\n        }\r\n\r\n        .bar {\r\n            width: 38%;\r\n            background: var(--primary);\r\n            border-radius: 6px 6px 0 0;\r\n            transition: 0.2s;\r\n            position: relative;\r\n        }\r\n\r\n        .bar.secondary {\r\n            background: #bfdbfe;\r\n        }\r\n\r\n        .bar:hover {\r\n            filter: brightness(0.9);\r\n            transform: translateY(-3px);\r\n        }\r\n\r\n        .bar-label {\r\n            position: absolute;\r\n            bottom: -28px;\r\n            color: var(--text-secondary);\r\n            font-size: 12px;\r\n        }\r\n\r\n        /* DONUT */\r\n\r\n        .donut-wrapper {\r\n            display: grid;\r\n            place-items: center;\r\n            padding: 20px 0;\r\n        }\r\n\r\n        .donut {\r\n            width: 170px;\r\n            height: 170px;\r\n            border-radius: 50%;\r\n            background:\r\n                conic-gradient(\r\n                    var(--primary) 0% 46%,\r\n                    #7c3aed 46% 72%,\r\n                    #14b8a6 72% 88%,\r\n                    #e5e7eb 88% 100%\r\n                );\r\n            position: relative;\r\n        }\r\n\r\n        .donut::after {\r\n            content: \"Sales\\A100%\";\r\n            white-space: pre;\r\n            position: absolute;\r\n            inset: 28px;\r\n            border-radius: 50%;\r\n            background: white;\r\n            display: grid;\r\n            place-items: center;\r\n            text-align: center;\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .legend {\r\n            margin-top: 10px;\r\n        }\r\n\r\n        .legend-item {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 10px 0;\r\n            border-bottom: 1px solid var(--border);\r\n            font-size: 14px;\r\n        }\r\n\r\n        /* TABLE */\r\n\r\n        .table-card {\r\n            overflow-x: auto;\r\n        }\r\n\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        th {\r\n            text-align: left;\r\n            color: var(--text-secondary);\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n            padding: 14px;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        td {\r\n            padding: 16px 14px;\r\n            font-size: 14px;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .status {\r\n            display: inline-block;\r\n            padding: 5px 10px;\r\n            border-radius: 20px;\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .status.completed {\r\n            background: #dcfce7;\r\n            color: #15803d;\r\n        }\r\n\r\n        .status.pending {\r\n            background: #fef3c7;\r\n            color: #b45309;\r\n        }\r\n\r\n        /* TOAST */\r\n\r\n        .toast {\r\n            position: fixed;\r\n            right: 24px;\r\n            bottom: 24px;\r\n            background: #111827;\r\n            color: white;\r\n            padding: 14px 18px;\r\n            border-radius: 10px;\r\n            transform: translateY(120px);\r\n            opacity: 0;\r\n            transition: 0.3s;\r\n            z-index: 300;\r\n        }\r\n\r\n        .toast.show {\r\n            transform: translateY(0);\r\n            opacity: 1;\r\n        }\r\n\r\n        /* RESPONSIVE */\r\n\r\n        @media (max-width: 1100px) {\r\n            .metrics-grid {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n        }\r\n\r\n        @media (max-width: 800px) {\r\n            .sidebar {\r\n                transform: translateX(-100%);\r\n            }\r\n\r\n            .sidebar.open {\r\n                transform: translateX(0);\r\n            }\r\n\r\n            .main {\r\n                margin-left: 0;\r\n                padding: 20px;\r\n            }\r\n\r\n            .menu-button {\r\n                display: grid;\r\n                place-items: center;\r\n            }\r\n\r\n            .content-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 600px) {\r\n            .topbar {\r\n                align-items: flex-start;\r\n                flex-direction: column;\r\n            }\r\n\r\n            .topbar-actions {\r\n                width: 100%;\r\n            }\r\n\r\n            .date-select,\r\n            .export-button {\r\n                flex: 1;\r\n            }\r\n\r\n            .metrics-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            h1 {\r\n                font-size: 24px;\r\n            }\r\n\r\n            .chart {\r\n                gap: 10px;\r\n            }\r\n\r\n            .bar {\r\n                width: 45%;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"app\">\r\n\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n\r\n        <div class=\"brand\">\r\n            <div class=\"brand-icon\">S</div>\r\n            SalesFlow\r\n        </div>\r\n\r\n        <div class=\"nav-label\">ANALYTICS</div>\r\n\r\n        <button class=\"nav-item active\" data-view=\"overview\">\r\n            Overview\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"sales\">\r\n            Sales\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"customers\">\r\n            Customers\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"products\">\r\n            Products\r\n        </button>\r\n\r\n        <div class=\"nav-label\">MANAGEMENT</div>\r\n\r\n        <button class=\"nav-item\" data-view=\"reports\">\r\n            Reports\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"settings\">\r\n            Settings\r\n        </button>\r\n\r\n        <div class=\"sidebar-bottom\">\r\n\r\n            <div class=\"user-card\">\r\n                <div class=\"avatar\">LC</div>\r\n\r\n                <div class=\"user-info\">\r\n                    <strong>Admin User</strong>\r\n                    <span>Sales Manager</span>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </aside>\r\n\r\n    <main class=\"main\">\r\n\r\n        <header class=\"topbar\">\r\n\r\n            <div class=\"topbar-left\">\r\n\r\n                <button class=\"menu-button\" id=\"menuButton\">\r\n                    ☰\r\n                </button>\r\n\r\n                <div>\r\n                    <h1 id=\"pageTitle\">Sales Overview</h1>\r\n\r\n                    <p class=\"subtitle\">\r\n                        Track your sales performance and business growth.\r\n                    </p>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"topbar-actions\">\r\n\r\n                <button class=\"date-select\" id=\"dateButton\">\r\n                    Last 30 Days\r\n                </button>\r\n\r\n                <button class=\"export-button\" id=\"exportButton\">\r\n                    Export Report\r\n                </button>\r\n\r\n            </div>\r\n\r\n        </header>\r\n\r\n        <section class=\"metrics-grid\">\r\n\r\n            <article class=\"metric-card\">\r\n\r\n                <div class=\"metric-header\">\r\n                    <span class=\"metric-title\">Total Revenue</span>\r\n\r\n                    <div class=\"metric-icon\">💰</div>\r\n                </div>\r\n\r\n                <div class=\"metric-value\">$84,250</div>\r\n\r\n                <div class=\"metric-change positive\">\r\n                    ↑ 12.5% vs last month\r\n                </div>\r\n\r\n            </article>\r\n\r\n            <article class=\"metric-card\">\r\n\r\n                <div class=\"metric-header\">\r\n                    <span class=\"metric-title\">Total Orders</span>\r\n\r\n                    <div class=\"metric-icon\">🛒</div>\r\n                </div>\r\n\r\n                <div class=\"metric-value\">1,248</div>\r\n\r\n                <div class=\"metric-change positive\">\r\n                    ↑ 8.2% vs last month\r\n                </div>\r\n\r\n            </article>\r\n\r\n            <article class=\"metric-card\">\r\n\r\n                <div class=\"metric-header\">\r\n                    <span class=\"metric-title\">Customers</span>\r\n\r\n                    <div class=\"metric-icon\">👥</div>\r\n                </div>\r\n\r\n                <div class=\"metric-value\">892</div>\r\n\r\n                <div class=\"metric-change positive\">\r\n                    ↑ 6.8% vs last month\r\n                </div>\r\n\r\n            </article>\r\n\r\n            <article class=\"metric-card\">\r\n\r\n                <div class=\"metric-header\">\r\n                    <span class=\"metric-title\">Conversion Rate</span>\r\n\r\n                    <div class=\"metric-icon\">📈</div>\r\n                </div>\r\n\r\n                <div class=\"metric-value\">4.8%</div>\r\n\r\n                <div class=\"metric-change negative\">\r\n                    ↓ 1.2% vs last month\r\n                </div>\r\n\r\n            </article>\r\n\r\n        </section>\r\n\r\n        <section class=\"content-grid\">\r\n\r\n            <article class=\"card\">\r\n\r\n                <div class=\"card-header\">\r\n                    <h2>Revenue Performance</h2>\r\n\r\n                    <span>Monthly</span>\r\n                </div>\r\n\r\n                <div class=\"chart\">\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 42%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 35%\"></div>\r\n                        <span class=\"bar-label\">Jan</span>\r\n                    </div>\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 58%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 48%\"></div>\r\n                        <span class=\"bar-label\">Feb</span>\r\n                    </div>\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 48%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 41%\"></div>\r\n                        <span class=\"bar-label\">Mar</span>\r\n                    </div>\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 70%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 56%\"></div>\r\n                        <span class=\"bar-label\">Apr</span>\r\n                    </div>\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 78%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 62%\"></div>\r\n                        <span class=\"bar-label\">May</span>\r\n                    </div>\r\n\r\n                    <div class=\"bar-group\">\r\n                        <div class=\"bar\" style=\"height: 92%\"></div>\r\n                        <div class=\"bar secondary\" style=\"height: 72%\"></div>\r\n                        <span class=\"bar-label\">Jun</span>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </article>\r\n\r\n            <article class=\"card\">\r\n\r\n                <div class=\"card-header\">\r\n                    <h2>Sales Channels</h2>\r\n\r\n                    <span>This Month</span>\r\n                </div>\r\n\r\n                <div class=\"donut-wrapper\">\r\n\r\n                    <div class=\"donut\"></div>\r\n\r\n                </div>\r\n\r\n                <div class=\"legend\">\r\n\r\n                    <div class=\"legend-item\">\r\n                        <span>Online Store</span>\r\n                        <strong>46%</strong>\r\n                    </div>\r\n\r\n                    <div class=\"legend-item\">\r\n                        <span>Direct Sales</span>\r\n                        <strong>26%</strong>\r\n                    </div>\r\n\r\n                    <div class=\"legend-item\">\r\n                        <span>Partners</span>\r\n                        <strong>16%</strong>\r\n                    </div>\r\n\r\n                    <div class=\"legend-item\">\r\n                        <span>Other</span>\r\n                        <strong>12%</strong>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </article>\r\n\r\n        </section>\r\n\r\n        <section class=\"card table-card\">\r\n\r\n            <div class=\"card-header\">\r\n\r\n                <h2>Recent Orders</h2>\r\n\r\n                <span id=\"orderCount\">5 Orders</span>\r\n\r\n            </div>\r\n\r\n            <table>\r\n\r\n                <thead>\r\n\r\n                    <tr>\r\n                        <th>Order ID</th>\r\n                        <th>Customer</th>\r\n                        <th>Product</th>\r\n                        <th>Amount</th>\r\n                        <th>Status</th>\r\n                    </tr>\r\n\r\n                </thead>\r\n\r\n                <tbody id=\"ordersBody\"></tbody>\r\n\r\n            </table>\r\n\r\n        </section>\r\n\r\n    </main>\r\n\r\n</div>\r\n\r\n<div class=\"toast\" id=\"toast\">\r\n    Report exported successfully.\r\n</div>\r\n\r\n<script>\r\n\r\n    const orders = [\r\n        {\r\n            id: \"#ORD-1048\",\r\n            customer: \"Sarah Johnson\",\r\n            product: \"Enterprise Plan\",\r\n            amount: \"$1,250\",\r\n            status: \"Completed\"\r\n        },\r\n        {\r\n            id: \"#ORD-1047\",\r\n            customer: \"Michael Brown\",\r\n            product: \"Professional Plan\",\r\n            amount: \"$780\",\r\n            status: \"Completed\"\r\n        },\r\n        {\r\n            id: \"#ORD-1046\",\r\n            customer: \"Emma Davis\",\r\n            product: \"Business Plan\",\r\n            amount: \"$540\",\r\n            status: \"Pending\"\r\n        },\r\n        {\r\n            id: \"#ORD-1045\",\r\n            customer: \"James Wilson\",\r\n            product: \"Enterprise Plan\",\r\n            amount: \"$1,450\",\r\n            status: \"Completed\"\r\n        },\r\n        {\r\n            id: \"#ORD-1044\",\r\n            customer: \"Olivia Smith\",\r\n            product: \"Starter Plan\",\r\n            amount: \"$290\",\r\n            status: \"Pending\"\r\n        }\r\n    ];\r\n\r\n    const ordersBody =\r\n        document.getElementById(\"ordersBody\");\r\n\r\n    function renderOrders() {\r\n\r\n        ordersBody.innerHTML = \"\";\r\n\r\n        orders.forEach(order => {\r\n\r\n            const row =\r\n                document.createElement(\"tr\");\r\n\r\n            const statusClass =\r\n                order.status === \"Completed\"\r\n                    ? \"completed\"\r\n                    : \"pending\";\r\n\r\n            row.innerHTML = `\r\n                <td>${order.id}</td>\r\n                <td>${order.customer}</td>\r\n                <td>${order.product}</td>\r\n                <td>${order.amount}</td>\r\n                <td>\r\n                    <span class=\"status ${statusClass}\">\r\n                        ${order.status}\r\n                    </span>\r\n                </td>\r\n            `;\r\n\r\n            ordersBody.appendChild(row);\r\n\r\n        });\r\n\r\n    }\r\n\r\n    renderOrders();\r\n\r\n\r\n    const sidebar =\r\n        document.getElementById(\"sidebar\");\r\n\r\n    const menuButton =\r\n        document.getElementById(\"menuButton\");\r\n\r\n    menuButton.addEventListener(\r\n        \"click\",\r\n        () => {\r\n            sidebar.classList.toggle(\"open\");\r\n        }\r\n    );\r\n\r\n\r\n    const navItems =\r\n        document.querySelectorAll(\".nav-item\");\r\n\r\n    const pageTitle =\r\n        document.getElementById(\"pageTitle\");\r\n\r\n    navItems.forEach(item => {\r\n\r\n        item.addEventListener(\r\n            \"click\",\r\n            () => {\r\n\r\n                navItems.forEach(\r\n                    nav => nav.classList.remove(\"active\")\r\n                );\r\n\r\n                item.classList.add(\"active\");\r\n\r\n                pageTitle.textContent =\r\n                    item.textContent.trim();\r\n\r\n                if (\r\n                    window.innerWidth <= 800\r\n                ) {\r\n                    sidebar.classList.remove(\"open\");\r\n                }\r\n\r\n            }\r\n        );\r\n\r\n    });\r\n\r\n\r\n    const exportButton =\r\n        document.getElementById(\"exportButton\");\r\n\r\n    const toast =\r\n        document.getElementById(\"toast\");\r\n\r\n    exportButton.addEventListener(\r\n        \"click\",\r\n        () => {\r\n\r\n            toast.classList.add(\"show\");\r\n\r\n            setTimeout(\r\n                () => {\r\n                    toast.classList.remove(\"show\");\r\n                },\r\n                2500\r\n            );\r\n\r\n        }\r\n    );\r\n\r\n\r\n    const dateButton =\r\n        document.getElementById(\"dateButton\");\r\n\r\n    const ranges = [\r\n        \"Last 7 Days\",\r\n        \"Last 30 Days\",\r\n        \"Last 90 Days\",\r\n        \"This Year\"\r\n    ];\r\n\r\n    let rangeIndex = 1;\r\n\r\n    dateButton.addEventListener(\r\n        \"click\",\r\n        () => {\r\n\r\n            rangeIndex =\r\n                (rangeIndex + 1) %\r\n                ranges.length;\r\n\r\n            dateButton.textContent =\r\n                ranges[rangeIndex];\r\n\r\n        }\r\n    );\r\n\r\n</script>\r\n\r\n</body>\r\n</html>"
  }
