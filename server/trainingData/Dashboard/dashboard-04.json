  "output": {
    "message": "A premium interactive project management dashboard for a software development team.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <title>TaskFlow Project Dashboard</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #5b5ce2;\r\n            --primary-dark: #4546c9;\r\n            --background: #f6f7fb;\r\n            --surface: #ffffff;\r\n            --surface-secondary: #f1f3f9;\r\n            --text-primary: #171725;\r\n            --text-secondary: #7a7d8c;\r\n            --border: #e7e8ef;\r\n            --success: #18a874;\r\n            --warning: #f0a52b;\r\n            --danger: #e65353;\r\n            --purple: #8b5cf6;\r\n            --blue: #3b82f6;\r\n            --sidebar: #171725;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: Inter, Arial, sans-serif;\r\n            background: var(--background);\r\n            color: var(--text-primary);\r\n        }\r\n\r\n        .app {\r\n            display: flex;\r\n            min-height: 100vh;\r\n        }\r\n\r\n        /* SIDEBAR */\r\n\r\n        .sidebar {\r\n            width: 250px;\r\n            background: var(--sidebar);\r\n            color: white;\r\n            padding: 28px 18px;\r\n            display: flex;\r\n            flex-direction: column;\r\n            position: fixed;\r\n            height: 100vh;\r\n            left: 0;\r\n            top: 0;\r\n        }\r\n\r\n        .logo {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n            font-size: 22px;\r\n            font-weight: 700;\r\n            margin-bottom: 45px;\r\n            padding-left: 10px;\r\n        }\r\n\r\n        .logo-icon {\r\n            width: 34px;\r\n            height: 34px;\r\n            background: var(--primary);\r\n            border-radius: 10px;\r\n            display: grid;\r\n            place-items: center;\r\n        }\r\n\r\n        .nav-section {\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .nav-label {\r\n            color: #77798a;\r\n            font-size: 11px;\r\n            font-weight: 700;\r\n            letter-spacing: 1px;\r\n            margin: 0 10px 10px;\r\n        }\r\n\r\n        .nav-item {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n            padding: 12px 12px;\r\n            margin-bottom: 5px;\r\n            border-radius: 9px;\r\n            color: #a9aab8;\r\n            cursor: pointer;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .nav-item:hover,\r\n        .nav-item.active {\r\n            background: rgba(255, 255, 255, 0.08);\r\n            color: white;\r\n        }\r\n\r\n        .nav-icon {\r\n            width: 20px;\r\n            text-align: center;\r\n        }\r\n\r\n        .upgrade-card {\r\n            margin-top: auto;\r\n            background: linear-gradient(\r\n                135deg,\r\n                #5b5ce2,\r\n                #8b5cf6\r\n            );\r\n            padding: 18px;\r\n            border-radius: 15px;\r\n        }\r\n\r\n        .upgrade-card h4 {\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .upgrade-card p {\r\n            font-size: 12px;\r\n            opacity: 0.85;\r\n            line-height: 1.5;\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        .upgrade-card button {\r\n            width: 100%;\r\n            border: none;\r\n            background: white;\r\n            color: var(--primary);\r\n            padding: 9px;\r\n            border-radius: 8px;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n        }\r\n\r\n        /* MAIN */\r\n\r\n        .main {\r\n            margin-left: 250px;\r\n            width: calc(100% - 250px);\r\n            padding: 28px 38px;\r\n        }\r\n\r\n        .topbar {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            margin-bottom: 35px;\r\n        }\r\n\r\n        .search {\r\n            width: 320px;\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            padding: 12px 15px;\r\n            border-radius: 10px;\r\n            display: flex;\r\n            gap: 10px;\r\n            align-items: center;\r\n        }\r\n\r\n        .search input {\r\n            border: none;\r\n            outline: none;\r\n            width: 100%;\r\n            font-size: 14px;\r\n            background: transparent;\r\n        }\r\n\r\n        .top-actions {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 15px;\r\n        }\r\n\r\n        .icon-button {\r\n            width: 40px;\r\n            height: 40px;\r\n            border-radius: 10px;\r\n            border: 1px solid var(--border);\r\n            background: var(--surface);\r\n            cursor: pointer;\r\n        }\r\n\r\n        .profile {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .avatar {\r\n            width: 40px;\r\n            height: 40px;\r\n            border-radius: 50%;\r\n            background: linear-gradient(\r\n                135deg,\r\n                #f59e0b,\r\n                #ec4899\r\n            );\r\n            display: grid;\r\n            place-items: center;\r\n            color: white;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .profile-info h4 {\r\n            font-size: 14px;\r\n        }\r\n\r\n        .profile-info span {\r\n            font-size: 12px;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        /* HEADER */\r\n\r\n        .page-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .page-header h1 {\r\n            font-size: 30px;\r\n            margin-bottom: 7px;\r\n        }\r\n\r\n        .page-header p {\r\n            color: var(--text-secondary);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .primary-button {\r\n            background: var(--primary);\r\n            border: none;\r\n            color: white;\r\n            padding: 12px 18px;\r\n            border-radius: 10px;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .primary-button:hover {\r\n            background: var(--primary-dark);\r\n            transform: translateY(-1px);\r\n        }\r\n\r\n        /* KPI CARDS */\r\n\r\n        .stats {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 18px;\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .stat-card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 15px;\r\n            padding: 20px;\r\n        }\r\n\r\n        .stat-top {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .stat-title {\r\n            color: var(--text-secondary);\r\n            font-size: 13px;\r\n        }\r\n\r\n        .stat-icon {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 10px;\r\n            display: grid;\r\n            place-items: center;\r\n            font-size: 17px;\r\n        }\r\n\r\n        .purple {\r\n            background: #ede9fe;\r\n            color: var(--purple);\r\n        }\r\n\r\n        .blue {\r\n            background: #dbeafe;\r\n            color: var(--blue);\r\n        }\r\n\r\n        .green {\r\n            background: #d1fae5;\r\n            color: var(--success);\r\n        }\r\n\r\n        .orange {\r\n            background: #fef3c7;\r\n            color: var(--warning);\r\n        }\r\n\r\n        .stat-value {\r\n            font-size: 27px;\r\n            font-weight: 700;\r\n            margin-bottom: 7px;\r\n        }\r\n\r\n        .stat-change {\r\n            font-size: 12px;\r\n            color: var(--success);\r\n        }\r\n\r\n        /* PROJECT OVERVIEW */\r\n\r\n        .content-grid {\r\n            display: grid;\r\n            grid-template-columns: 1.6fr 1fr;\r\n            gap: 22px;\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 15px;\r\n            padding: 23px;\r\n        }\r\n\r\n        .card-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .card-header h3 {\r\n            font-size: 17px;\r\n        }\r\n\r\n        .more {\r\n            color: var(--text-secondary);\r\n            cursor: pointer;\r\n        }\r\n\r\n        /* PROJECT PROGRESS */\r\n\r\n        .project-row {\r\n            margin-bottom: 22px;\r\n        }\r\n\r\n        .project-info {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            margin-bottom: 9px;\r\n        }\r\n\r\n        .project-name {\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .project-percent {\r\n            font-size: 13px;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        .progress {\r\n            width: 100%;\r\n            height: 8px;\r\n            background: var(--surface-secondary);\r\n            border-radius: 20px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .progress-bar {\r\n            height: 100%;\r\n            border-radius: 20px;\r\n            transition: width 0.4s ease;\r\n        }\r\n\r\n        /* TEAM */\r\n\r\n        .team-member {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            padding: 13px 0;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .team-member:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .member-left {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 11px;\r\n        }\r\n\r\n        .member-avatar {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 50%;\r\n            display: grid;\r\n            place-items: center;\r\n            color: white;\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .member-info h4 {\r\n            font-size: 13px;\r\n            margin-bottom: 3px;\r\n        }\r\n\r\n        .member-info span {\r\n            color: var(--text-secondary);\r\n            font-size: 11px;\r\n        }\r\n\r\n        .status-dot {\r\n            width: 9px;\r\n            height: 9px;\r\n            border-radius: 50%;\r\n            background: var(--success);\r\n        }\r\n\r\n        /* TASKS */\r\n\r\n        .task-list {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 13px;\r\n        }\r\n\r\n        .task {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 13px;\r\n            padding: 15px;\r\n            border: 1px solid var(--border);\r\n            border-radius: 11px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .task:hover {\r\n            background: var(--surface-secondary);\r\n        }\r\n\r\n        .task-checkbox {\r\n            width: 20px;\r\n            height: 20px;\r\n            border: 2px solid var(--border);\r\n            border-radius: 6px;\r\n            cursor: pointer;\r\n            flex-shrink: 0;\r\n        }\r\n\r\n        .task.completed .task-checkbox {\r\n            background: var(--success);\r\n            border-color: var(--success);\r\n        }\r\n\r\n        .task.completed .task-name {\r\n            text-decoration: line-through;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        .task-content {\r\n            flex: 1;\r\n        }\r\n\r\n        .task-name {\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n            margin-bottom: 5px;\r\n        }\r\n\r\n        .task-meta {\r\n            font-size: 12px;\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        .priority {\r\n            font-size: 11px;\r\n            padding: 5px 9px;\r\n            border-radius: 20px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .high {\r\n            color: var(--danger);\r\n            background: #fee2e2;\r\n        }\r\n\r\n        .medium {\r\n            color: var(--warning);\r\n            background: #fef3c7;\r\n        }\r\n\r\n        .low {\r\n            color: var(--success);\r\n            background: #d1fae5;\r\n        }\r\n\r\n        /* RESPONSIVE */\r\n\r\n        @media (max-width: 1100px) {\r\n\r\n            .stats {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .content-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n        }\r\n\r\n        @media (max-width: 800px) {\r\n\r\n            .sidebar {\r\n                width: 70px;\r\n                padding: 20px 10px;\r\n            }\r\n\r\n            .logo span,\r\n            .nav-item span,\r\n            .nav-label,\r\n            .upgrade-card {\r\n                display: none;\r\n            }\r\n\r\n            .logo {\r\n                justify-content: center;\r\n                padding: 0;\r\n            }\r\n\r\n            .nav-item {\r\n                justify-content: center;\r\n            }\r\n\r\n            .main {\r\n                margin-left: 70px;\r\n                width: calc(100% - 70px);\r\n                padding: 22px;\r\n            }\r\n\r\n        }\r\n\r\n        @media (max-width: 600px) {\r\n\r\n            .main {\r\n                margin-left: 0;\r\n                width: 100%;\r\n                padding: 18px;\r\n            }\r\n\r\n            .sidebar {\r\n                display: none;\r\n            }\r\n\r\n            .search {\r\n                display: none;\r\n            }\r\n\r\n            .profile-info {\r\n                display: none;\r\n            }\r\n\r\n            .page-header {\r\n                align-items: flex-start;\r\n                flex-direction: column;\r\n                gap: 15px;\r\n            }\r\n\r\n            .stats {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"app\">\r\n\r\n    <aside class=\"sidebar\">\r\n\r\n        <div class=\"logo\">\r\n            <div class=\"logo-icon\">✓</div>\r\n            <span>TaskFlow</span>\r\n        </div>\r\n\r\n        <div class=\"nav-section\">\r\n\r\n            <div class=\"nav-label\">WORKSPACE</div>\r\n\r\n            <div class=\"nav-item active\">\r\n                <div class=\"nav-icon\">▦</div>\r\n                <span>Overview</span>\r\n            </div>\r\n\r\n            <div class=\"nav-item\">\r\n                <div class=\"nav-icon\">✓</div>\r\n                <span>My Tasks</span>\r\n            </div>\r\n\r\n            <div class=\"nav-item\">\r\n                <div class=\"nav-icon\">▤</div>\r\n                <span>Projects</span>\r\n            </div>\r\n\r\n            <div class=\"nav-item\">\r\n                <div class=\"nav-icon\">◉</div>\r\n                <span>Team</span>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div class=\"nav-section\">\r\n\r\n            <div class=\"nav-label\">MANAGEMENT</div>\r\n\r\n            <div class=\"nav-item\">\r\n                <div class=\"nav-icon\">▣</div>\r\n                <span>Analytics</span>\r\n            </div>\r\n\r\n            <div class=\"nav-item\">\r\n                <div class=\"nav-icon\">⚙</div>\r\n                <span>Settings</span>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div class=\"upgrade-card\">\r\n\r\n            <h4>Upgrade your team</h4>\r\n\r\n            <p>\r\n                Unlock advanced analytics,\r\n                automation and unlimited projects.\r\n            </p>\r\n\r\n            <button onclick=\"alert('Upgrade options opened!')\">\r\n                Upgrade\r\n            </button>\r\n\r\n        </div>\r\n\r\n    </aside>\r\n\r\n\r\n    <main class=\"main\">\r\n\r\n        <div class=\"topbar\">\r\n\r\n            <div class=\"search\">\r\n                <span>⌕</span>\r\n                <input\r\n                    id=\"searchInput\"\r\n                    placeholder=\"Search projects or tasks...\"\r\n                >\r\n            </div>\r\n\r\n            <div class=\"top-actions\">\r\n\r\n                <button\r\n                    class=\"icon-button\"\r\n                    onclick=\"alert('No new notifications')\"\r\n                >\r\n                    🔔\r\n                </button>\r\n\r\n                <div class=\"profile\">\r\n\r\n                    <div class=\"avatar\">\r\n                        LC\r\n                    </div>\r\n\r\n                    <div class=\"profile-info\">\r\n                        <h4>Alex Morgan</h4>\r\n                        <span>Project Manager</span>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n\r\n        <div class=\"page-header\">\r\n\r\n            <div>\r\n                <h1>Good morning, Alex 👋</h1>\r\n\r\n                <p>\r\n                    Here is what is happening with your projects today.\r\n                </p>\r\n            </div>\r\n\r\n            <button\r\n                class=\"primary-button\"\r\n                onclick=\"addTask()\"\r\n            >\r\n                + New Task\r\n            </button>\r\n\r\n        </div>\r\n\r\n\r\n        <section class=\"stats\">\r\n\r\n            <div class=\"stat-card\">\r\n\r\n                <div class=\"stat-top\">\r\n\r\n                    <span class=\"stat-title\">\r\n                        Active Projects\r\n                    </span>\r\n\r\n                    <div class=\"stat-icon purple\">\r\n                        ▤\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"stat-value\">\r\n                    12\r\n                </div>\r\n\r\n                <div class=\"stat-change\">\r\n                    +2 this month\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"stat-card\">\r\n\r\n                <div class=\"stat-top\">\r\n\r\n                    <span class=\"stat-title\">\r\n                        Completed Tasks\r\n                    </span>\r\n\r\n                    <div class=\"stat-icon green\">\r\n                        ✓\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"stat-value\">\r\n                    248\r\n                </div>\r\n\r\n                <div class=\"stat-change\">\r\n                    +18.5% this month\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"stat-card\">\r\n\r\n                <div class=\"stat-top\">\r\n\r\n                    <span class=\"stat-title\">\r\n                        Pending Tasks\r\n                    </span>\r\n\r\n                    <div class=\"stat-icon orange\">\r\n                        ⏱\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"stat-value\">\r\n                    37\r\n                </div>\r\n\r\n                <di