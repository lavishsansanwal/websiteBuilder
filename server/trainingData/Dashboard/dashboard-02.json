{
  "input": {
    "pageType": "dashboard",
    "prompt": "Create a premium modern project management dashboard for a software development team. Include project progress, task statistics, team members, upcoming deadlines, project activity, and interactive task filtering."
  },
  "output": {
    "message": "A premium interactive project management dashboard for a software development team.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <title>FlowTask — Project Dashboard</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #635bff;\r\n            --primary-dark: #5148e5;\r\n            --bg: #f6f7fb;\r\n            --surface: #ffffff;\r\n            --surface-secondary: #f8f8fc;\r\n            --text: #17181c;\r\n            --muted: #747780;\r\n            --border: #e8e9ef;\r\n            --success: #18a875;\r\n            --warning: #e69b27;\r\n            --danger: #e34b59;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            background: var(--bg);\r\n            color: var(--text);\r\n        }\r\n\r\n        button,\r\n        input,\r\n        select {\r\n            font: inherit;\r\n        }\r\n\r\n        button {\r\n            cursor: pointer;\r\n            border: none;\r\n        }\r\n\r\n        .app {\r\n            display: flex;\r\n            min-height: 100vh;\r\n        }\r\n\r\n        /* SIDEBAR */\r\n\r\n        .sidebar {\r\n            width: 250px;\r\n            background: #171820;\r\n            color: white;\r\n            padding: 24px 16px;\r\n            display: flex;\r\n            flex-direction: column;\r\n            position: fixed;\r\n            height: 100vh;\r\n        }\r\n\r\n        .logo {\r\n            font-size: 22px;\r\n            font-weight: 800;\r\n            padding: 0 12px;\r\n            margin-bottom: 40px;\r\n        }\r\n\r\n        .logo span {\r\n            color: #8b85ff;\r\n        }\r\n\r\n        .nav {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 6px;\r\n        }\r\n\r\n        .nav button {\r\n            background: transparent;\r\n            color: #a7a8b3;\r\n            text-align: left;\r\n            padding: 13px 14px;\r\n            border-radius: 10px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .nav button:hover,\r\n        .nav button.active {\r\n            background: #282a36;\r\n            color: white;\r\n        }\r\n\r\n        .workspace {\r\n            margin-top: auto;\r\n            padding: 15px 12px;\r\n            border-top: 1px solid #30313b;\r\n            color: #a7a8b3;\r\n            font-size: 14px;\r\n        }\r\n\r\n        /* MAIN */\r\n\r\n        .main {\r\n            flex: 1;\r\n            margin-left: 250px;\r\n            padding: 32px;\r\n        }\r\n\r\n        .topbar {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .title h1 {\r\n            font-size: 30px;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .title p {\r\n            color: var(--muted);\r\n        }\r\n\r\n        .profile {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n        }\r\n\r\n        .avatar {\r\n            width: 42px;\r\n            height: 42px;\r\n            border-radius: 50%;\r\n            display: grid;\r\n            place-items: center;\r\n            background: var(--primary);\r\n            color: white;\r\n            font-weight: bold;\r\n        }\r\n\r\n        /* CONTROLS */\r\n\r\n        .controls {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            gap: 15px;\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .search {\r\n            flex: 1;\r\n            max-width: 400px;\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 10px;\r\n            padding: 12px 15px;\r\n        }\r\n\r\n        .filter-group {\r\n            display: flex;\r\n            gap: 10px;\r\n        }\r\n\r\n        select,\r\n        .add-task {\r\n            padding: 12px 15px;\r\n            border-radius: 10px;\r\n        }\r\n\r\n        select {\r\n            border: 1px solid var(--border);\r\n            background: white;\r\n        }\r\n\r\n        .add-task {\r\n            background: var(--primary);\r\n            color: white;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .add-task:hover {\r\n            background: var(--primary-dark);\r\n        }\r\n\r\n        /* STATS */\r\n\r\n        .stats {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 20px;\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .stat-card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            padding: 22px;\r\n            border-radius: 14px;\r\n        }\r\n\r\n        .stat-label {\r\n            color: var(--muted);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .stat-value {\r\n            font-size: 28px;\r\n            font-weight: 750;\r\n            margin: 10px 0;\r\n        }\r\n\r\n        .stat-change {\r\n            font-size: 13px;\r\n            color: var(--success);\r\n        }\r\n\r\n        /* CONTENT GRID */\r\n\r\n        .content-grid {\r\n            display: grid;\r\n            grid-template-columns: 1.5fr 1fr;\r\n            gap: 24px;\r\n        }\r\n\r\n        .card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 14px;\r\n            padding: 22px;\r\n        }\r\n\r\n        .card-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        .card h2 {\r\n            font-size: 18px;\r\n        }\r\n\r\n        /* PROJECTS */\r\n\r\n        .project {\r\n            padding: 17px 0;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .project:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .project-top {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .project-name {\r\n            font-weight: 650;\r\n        }\r\n\r\n        .percentage {\r\n            color: var(--muted);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .progress {\r\n            width: 100%;\r\n            height: 8px;\r\n            background: #ececf2;\r\n            border-radius: 20px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .progress-bar {\r\n            height: 100%;\r\n            background: var(--primary);\r\n            border-radius: inherit;\r\n            transition: width 0.5s;\r\n        }\r\n\r\n        /* TASKS */\r\n\r\n        .task-list {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 12px;\r\n        }\r\n\r\n        .task {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            padding: 14px;\r\n            border: 1px solid var(--border);\r\n            border-radius: 10px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .task:hover {\r\n            background: var(--surface-secondary);\r\n        }\r\n\r\n        .task-left {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n        }\r\n\r\n        .task input {\r\n            width: 17px;\r\n            height: 17px;\r\n        }\r\n\r\n        .task.completed .task-name {\r\n            text-decoration: line-through;\r\n            color: var(--muted);\r\n        }\r\n\r\n        .badge {\r\n            padding: 5px 9px;\r\n            border-radius: 20px;\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .high {\r\n            background: #fde8eb;\r\n            color: var(--danger);\r\n        }\r\n\r\n        .medium {\r\n            background: #fff3dc;\r\n            color: var(--warning);\r\n        }\r\n\r\n        .low {\r\n            background: #e2f7ef;\r\n            color: var(--success);\r\n        }\r\n\r\n        /* ACTIVITY */\r\n\r\n        .activity {\r\n            display: flex;\r\n            gap: 12px;\r\n            padding: 14px 0;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .activity:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .activity-avatar {\r\n            width: 36px;\r\n            height: 36px;\r\n            border-radius: 50%;\r\n            background: #e7e5ff;\r\n            color: var(--primary);\r\n            display: grid;\r\n            place-items: center;\r\n            font-weight: bold;\r\n            flex-shrink: 0;\r\n        }\r\n\r\n        .activity-text {\r\n            font-size: 14px;\r\n            line-height: 1.5;\r\n        }\r\n\r\n        .activity-text span {\r\n            color: var(--muted);\r\n            font-size: 12px;\r\n        }\r\n\r\n        /* DEADLINES */\r\n\r\n        .deadline {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            padding: 14px 0;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .deadline:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .deadline-name {\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .deadline-date {\r\n            font-size: 13px;\r\n            color: var(--danger);\r\n        }\r\n\r\n        /* MODAL */\r\n\r\n        .modal {\r\n            position: fixed;\r\n            inset: 0;\r\n            background: rgba(0, 0, 0, 0.45);\r\n            display: none;\r\n            align-items: center;\r\n            justify-content: center;\r\n            padding: 20px;\r\n        }\r\n\r\n        .modal.show {\r\n            display: flex;\r\n        }\r\n\r\n        .modal-content {\r\n            background: white;\r\n            width: 100%;\r\n            max-width: 450px;\r\n            border-radius: 16px;\r\n            padding: 25px;\r\n        }\r\n\r\n        .modal-content h2 {\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        .modal-content input,\r\n        .modal-content select {\r\n            width: 100%;\r\n            margin-bottom: 15px;\r\n            padding: 12px;\r\n            border: 1px solid var(--border);\r\n            border-radius: 8px;\r\n        }\r\n\r\n        .modal-actions {\r\n            display: flex;\r\n            justify-content: flex-end;\r\n            gap: 10px;\r\n        }\r\n\r\n        .cancel {\r\n            padding: 10px 15px;\r\n            background: #eeeef3;\r\n            border-radius: 8px;\r\n        }\r\n\r\n        .save {\r\n            padding: 10px 15px;\r\n            background: var(--primary);\r\n            color: white;\r\n            border-radius: 8px;\r\n        }\r\n\r\n        /* RESPONSIVE */\r\n\r\n        @media (max-width: 1000px) {\r\n            .stats {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .content-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .sidebar {\r\n                width: 70px;\r\n                padding: 20px 8px;\r\n            }\r\n\r\n            .logo {\r\n                font-size: 0;\r\n                text-align: center;\r\n            }\r\n\r\n            .logo::first-letter {\r\n                font-size: 24px;\r\n            }\r\n\r\n            .nav button {\r\n                font-size: 0;\r\n                text-align: center;\r\n            }\r\n\r\n            .nav button::first-letter {\r\n                font-size: 16px;\r\n            }\r\n\r\n            .workspace {\r\n                display: none;\r\n            }\r\n\r\n            .main {\r\n                margin-left: 70px;\r\n                padding: 20px;\r\n            }\r\n\r\n            .topbar {\r\n                align-items: flex-start;\r\n            }\r\n\r\n            .profile-name {\r\n                display: none;\r\n            }\r\n\r\n            .controls {\r\n                flex-direction: column;\r\n            }\r\n\r\n            .search {\r\n                max-width: none;\r\n            }\r\n\r\n            .filter-group {\r\n                width: 100%;\r\n            }\r\n\r\n            .filter-group select,\r\n            .add-task {\r\n                flex: 1;\r\n            }\r\n\r\n            .stats {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"app\">\r\n\r\n    <aside class=\"sidebar\">\r\n\r\n        <div class=\"logo\">\r\n            Flow<span>Task</span>\r\n        </div>\r\n\r\n        <nav class=\"nav\">\r\n            <button class=\"active\">Dashboard</button>\r\n            <button>Projects</button>\r\n            <button>My Tasks</button>\r\n            <button>Team</button>\r\n            <button>Calendar</button>\r\n            <button>Reports</button>\r\n        </nav>\r\n\r\n        <div class=\"workspace\">\r\n            Acme Software Team\r\n        </div>\r\n\r\n    </aside>\r\n\r\n\r\n    <main class=\"main\">\r\n\r\n        <header class=\"topbar\">\r\n\r\n            <div class=\"title\">\r\n                <h1>Good morning, Alex</h1>\r\n                <p>Here's what's happening across your projects.</p>\r\n            </div>\r\n\r\n            <div class=\"profile\">\r\n                <span class=\"profile-name\">Alex Morgan</span>\r\n                <div class=\"avatar\">AM</div>\r\n            </div>\r\n\r\n        </header>\r\n\r\n\r\n        <section class=\"controls\">\r\n\r\n            <input\r\n                type=\"text\"\r\n                class=\"search\"\r\n                id=\"searchInput\"\r\n                placeholder=\"Search tasks...\"\r\n            >\r\n\r\n            <div class=\"filter-group\">\r\n\r\n                <select id=\"priorityFilter\">\r\n                    <option value=\"all\">All Priorities</option>\r\n                    <option value=\"high\">High Priority</option>\r\n                    <option value=\"medium\">Medium Priority</option>\r\n                    <option value=\"low\">Low Priority</option>\r\n                </select>\r\n\r\n                <button class=\"add-task\" id=\"addTaskBtn\">\r\n                    + Add Task\r\n                </button>\r\n\r\n            </div>\r\n\r\n        </section>\r\n\r\n\r\n        <section class=\"stats\">\r\n\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-label\">Active Projects</div>\r\n                <div class=\"stat-value\">12</div>\r\n                <div class=\"stat-change\">+2 this month</div>\r\n            </div>\r\n\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-label\">Tasks Completed</div>\r\n                <div class=\"stat-value\">84</div>\r\n                <div class=\"stat-change\">+18% this week</div>\r\n            </div>\r\n\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-label\">Tasks In Progress</div>\r\n                <div class=\"stat-value\">23</div>\r\n                <div class=\"stat-change\">On track</div>\r\n            </div>\r\n\r\n            <div class=\"stat-card\">\r\n                <div class=\"stat-label\">Team Productivity</div>\r\n                <div class=\"stat-value\">91%</div>\r\n                <div class=\"stat-change\">+6% improvement</div>\r\n            </div>\r\n\r\n        </section>\r\n\r\n\r\n        <section class=\"content-grid\">\r\n\r\n            <div>\r\n\r\n                <div class=\"card\">\r\n\r\n                    <div class=\"card-header\">\r\n                        <h2>Project Progress</h2>\r\n                        <span>Active projects</span>\r\n                    </div>\r\n\r\n                    <div class=\"project\">\r\n                        <div class=\"project-top\">\r\n                            <span class=\"project-name\">Website Redesign</span>\r\n                            <span class=\"percentage\">78%</span>\r\n                        </div>\r\n\r\n                        <div class=\"progress\">\r\n                            <div class=\"progress-bar\" style=\"width: 78%\"></div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"project\">\r\n                        <div class=\"project-top\">\r\n                            <span class=\"project-name\">Mobile Application</span>\r\n                            <span class=\"percentage\">62%</span>\r\n                        </div>\r\n\r\n                        <div class=\"progress\">\r\n                            <div class=\"progress-bar\" style=\"width: 62%\"></div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"project\">\r\n                        <div class=\"project-top\">\r\n                            <span class=\"project-name\">Analytics Platform</span>\r\n                            <span class=\"percentage\">45%</span>\r\n                        </div>\r\n\r\n                        <div class=\"progress\">\r\n                            <div class=\"progress-bar\" style=\"width: 45%\"></div>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n\r\n                <div class=\"card\" style=\"margin-top: 24px\">\r\n\r\n                    <div class=\"card-header\">\r\n                        <h2>My Tasks</h2>\r\n                        <span id=\"taskCount\">4 tasks</span>\r\n                    </div>\r\n\r\n                    <div class=\"task-list\" id=\"taskList\">\r\n\r\n                        <div class=\"task\" data-priority=\"high\">\r\n                            <div class=\"task-left\">\r\n                                <input type=\"checkbox\">\r\n                                <span class=\"task-name\">\r\n                                    Complete dashboard design\r\n                                </span>\r\n                            </div>\r\n\r\n                            <span class=\"badge high\">\r\n                                High\r\n                            </span>\r\n                        </div>\r\n\r\n\r\n                        <div class=\"task\" data-priority=\"medium\">\r\n                            <div class=\"task-left\">\r\n                                <input type=\"checkbox\">\r\n                                <span class=\"task-name\">\r\n                                    Review API documentation\r\n                                </span>\r\n                            </div>\r\n\r\n                            <span class=\"badge medium\">\r\n                                Medium\r\n                            </span>\r\n                        </div>\r\n\r\n\r\n                        <div class=\"task\" data-priority=\"high\">\r\n                            <div class=\"task-left\">\r\n                                <input type=\"checkbox\">\r\n                                <span class=\"task-name\">\r\n                                    Prepare sprint planning\r\n                                </span>\r\n                            </div>\r\n\r\n                            <span class=\"badge high\">\r\n                                High\r\n                            </span>\r\n                        </div>\r\n\r\n\r\n                        <div class=\"task\" data-priority=\"low\">\r\n                            <div class=\"task-left\">\r\n                                <input type=\"checkbox\">\r\n                                <span class=\"task-name\">\r\n                                    Update project documentation\r\n                                </span>\r\n                            </div>\r\n\r\n                            <span class=\"badge low\">\r\n                                Low\r\n                            </span>\r\n                        </div>\r\n\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div>\r\n\r\n                <div class=\"card\">\r\n\r\n                    <div class=\"card-header\">\r\n                        <h2>Recent Activity</h2>\r\n                    </div>\r\n\r\n                    <div class=\"activity\">\r\n                        <div class=\"activity-avatar\">JD</div>\r\n\r\n                        <div class=\"activity-text\">\r\n                            <strong>John Davis</strong>\r\n                            completed the authentication module.\r\n                            <br>\r\n                            <span>12 minutes ago</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                    <div class=\"activity\">\r\n                        <div class=\"activity-avatar\">SK</div>\r\n\r\n                        <div class=\"activity-text\">\r\n                            <strong>Sarah Kim</strong>\r\n                            added a new project task.\r\n                            <br>\r\n                            <span>1 hour ago</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                    <div class=\"activity\">\r\n                        <div class=\"activity-avatar\">RM</div>\r\n\r\n                        <div class=\"activity-text\">\r\n                            <strong>Ryan Miller</strong>\r\n                            updated the analytics project.\r\n                            <br>\r\n                            <span>3 hours ago</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n\r\n                <div class=\"card\" style=\"margin-top: 24px\">\r\n\r\n                    <div class=\"card-header\">\r\n                        <h2>Upcoming Deadlines</h2>\r\n                    </div>\r\n\r\n                    <div class=\"deadline\">\r\n                        <span class=\"deadline-name\">\r\n                            Dashboard Design\r\n                        </span>\r\n\r\n                        <span class=\"deadline-date\">\r\n                            Today\r\n                        </span>\r\n                    </div>\r\n\r\n                    <div class=\"deadline\">\r\n                        <span class=\"deadline-name\">\r\n                            API Integration\r\n                        </span>\r\n\r\n                        <span class=\"deadline-date\">\r\n                            Tomorrow\r\n                        </span>\r\n                    </div>\r\n\r\n                    <div class=\"deadline\">\r\n                        <span class=\"deadline-name\">\r\n                            Sprint Release\r\n                        </span>\r\n\r\n                        <span class=\"deadline-date\">\r\n                            Aug 28\r\n                        </span>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </section>\r\n\r\n    </main>\r\n\r\n</div>\r\n\r\n\r\n<div class=\"modal\" id=\"taskModal\">\r\n\r\n    <div class=\"modal-content\">\r\n\r\n        <h2>Add New Task</h2>\r\n\r\n        <input\r\n            type=\"text\"\r\n            id=\"newTaskName\"\r\n            placeholder=\"Enter task name\"\r\n        >\r\n\r\n        <select id=\"newTaskPriority\">\r\n            <option value=\"high\">High Priority</option>\r\n            <option value=\"medium\">Medium Priority</option>\r\n            <option value=\"low\">Low Priority</option>\r\n        </select>\r\n\r\n        <div class=\"modal-actions\">\r\n\r\n            <button\r\n                class=\"cancel\"\r\n                id=\"cancelTask\"\r\n            >\r\n                Cancel\r\n            </button>\r\n\r\n            <button\r\n                class=\"save\"\r\n                id=\"saveTask\"\r\n            >\r\n                Add Task\r\n            </button>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n<script>\r\n\r\n    const searchInput =\r\n        document.getElementById(\"searchInput\");\r\n\r\n    const priorityFilter =\r\n        document.getElementById(\"priorityFilter\");\r\n\r\n    const taskList =\r\n        document.getElementById(\"taskList\");\r\n\r\n    const taskCount =\r\n        document.getElementById(\"taskCount\");\r\n\r\n\r\n    function filterTasks() {\r\n\r\n        const search =\r\n            searchInput.value.toLowerCase();\r\n\r\n        const priority =\r\n            priorityFilter.value;\r\n\r\n        const tasks =\r\n            document.querySelectorAll(\".task\");\r\n\r\n        let visibleCount = 0;\r\n\r\n        tasks.forEach(task => {\r\n\r\n            const name =\r\n                task\r\n                    .querySelector(\".task-name\")\r\n                    .textContent\r\n                    .toLowerCase();\r\n\r\n            const taskPriority =\r\n                task.dataset.priority;\r\n\r\n            const matchesSearch =\r\n                name.includes(search);\r\n\r\n            const matchesPriority =\r\n                priority === \"all\" ||\r\n                taskPriority === priority;\r\n\r\n            if (\r\n                matchesSearch &&\r\n                matchesPriority\r\n            ) {\r\n\r\n                task.style.display =\r\n                    \"flex\";\r\n\r\n                visibleCount++;\r\n\r\n            } else {\r\n\r\n                task.style.display =\r\n                    \"none\";\r\n\r\n            }\r\n\r\n        });\r\n\r\n        taskCount.textContent =\r\n            `${visibleCount} tasks`;\r\n\r\n    }\r\n\r\n\r\n    searchInput.addEventListener(\r\n        \"input\",\r\n        filterTasks\r\n    );\r\n\r\n    priorityFilter.addEventListener(\r\n        \"change\",\r\n        filterTasks\r\n    );\r\n\r\n\r\n    document.addEventListener(\r\n        \"change\",\r\n        event => {\r\n\r\n            if (\r\n                event.target.matches(\r\n                    '.task input[type=\"checkbox\"]'\r\n                )\r\n            ) {\r\n\r\n                const task =\r\n                    event.target.closest(\".task\");\r\n\r\n                task.classList.toggle(\r\n                    \"completed\",\r\n                    event.target.checked\r\n                );\r\n\r\n            }\r\n\r\n        }\r\n    );\r\n\r\n\r\n    const taskModal =\r\n        document.getElementById(\"taskModal\");\r\n\r\n    const addTaskBtn =\r\n        document.getElementById(\"addTaskBtn\");\r\n\r\n    const cancelTask =\r\n        document.getElementById(\"cancelTask\");\r\n\r\n    const saveTask =\r\n        document.getElementById(\"saveTask\");\r\n\r\n    const newTaskName =\r\n        document.getElementById(\"newTaskName\");\r\n\r\n    const newTaskPriority =\r\n        document.getElementById(\r\n            \"newTaskPriority\"\r\n        );\r\n\r\n\r\n    addTaskBtn.addEventListener(\r\n        \"click\",\r\n        () => {\r\n\r\n            taskModal.classList.add(\"show\");\r\n\r\n        }\r\n    );\r\n\r\n\r\n    cancelTask.addEventListener(\r\n        \"click\",\r\n        () => {\r\n\r\n            taskModal.classList.remove(\"show\");\r\n\r\n        }\r\n    );\r\n\r\n\r\n    saveTask.addEventListener(\r\n        \"click\",\r\n        () => {\r\n\r\n            const taskName =\r\n                newTaskName.value.trim();\r\n\r\n            const priority =\r\n                newTaskPriority.value;\r\n\r\n            if (!taskName) {\r\n\r\n                alert(\r\n                    \"Please enter a task name.\"\r\n                );\r\n\r\n                return;\r\n\r\n            }\r\n\r\n            const task =\r\n                document.createElement(\"div\");\r\n\r\n            task.className =\r\n                \"task\";\r\n\r\n            task.dataset.priority =\r\n                priority;\r\n\r\n            task.innerHTML = `\r\n\r\n                <div class=\"task-left\">\r\n\r\n                    <input type=\"checkbox\">\r\n\r\n                    <span class=\"task-name\">\r\n                        ${taskName}\r\n                    </span>\r\n\r\n                </div>\r\n\r\n                <span class=\"badge ${priority}\">\r\n                    ${priority}\r\n                </span>\r\n\r\n            `;\r\n\r\n            taskList.appendChild(task);\r\n\r\n            newTaskName.value = \"\";\r\n\r\n            taskModal.classList.remove(\"show\");\r\n\r\n            filterTasks();\r\n\r\n        }\r\n    );\r\n\r\n\r\n    taskModal.addEventListener(\r\n        \"click\",\r\n        event => {\r\n\r\n            if (\r\n                event.target === taskModal\r\n            ) {\r\n\r\n                taskModal.classList.remove(\r\n                    \"show\"\r\n                );\r\n\r\n            }\r\n\r\n        }\r\n    );\r\n\r\n</script>\r\n\r\n</body>\r\n</html>"
  }
