ems.forEach(nav =>\r\n                nav.classList.remove(\"active\")\r\n            );\r\n\r\n            item.classList.add(\"active\");\r\n\r\n            const view =\r\n                item.getAttribute(\"data-view\");\r\n\r\n            pageTitle.textContent =\r\n                view === \"Overview\"\r\n                    ? \"Logistics Overview\"\r\n                    : view;\r\n\r\n            if (window.innerWidth <= 768) {\r\n\r\n                sidebar.classList.remove(\"open\");\r\n                overlay.classList.remove(\"show\");\r\n\r\n            }\r\n\r\n        });\r\n\r\n    });\r\n\r\n\r\n    const searchInput =\r\n        document.getElementById(\"searchInput\");\r\n\r\n    const tableRows =\r\n        document.querySelectorAll(\r\n            \"#shipmentTable tbody tr\"\r\n        );\r\n\r\n    searchInput.addEventListener(\r\n        \"input\",\r\n        event => {\r\n\r\n            const value =\r\n                event.target.value\r\n                    .toLowerCase();\r\n\r\n            tableRows.forEach(row => {\r\n\r\n                const text =\r\n                    row.textContent\r\n                        .toLowerCase();\r\n\r\n                row.style.display =\r\n                    text.includes(value)\r\n                        ? \"\"\r\n                        : \"none\";\r\n\r\n            });\r\n\r\n        }\r\n    );\r\n\r\n\r\n    const dateRange =\r\n        document.getElementById(\"dateRange\");\r\n\r\n    dateRange.addEventListener(\r\n        \"change\",\r\n        () => {\r\n\r\n            const activeShipments =\r\n                document.getElementById(\r\n                    \"activeShipments\"\r\n                );\r\n\r\n            const values = {\r\n                \"This Month\": \"1,248\",\r\n                \"Last 30 Days\": \"1,094\",\r\n                \"This Quarter\": \"3,762\",\r\n                \"This Year\": \"14,826\"\r\n            };\r\n\r\n            activeShipments.textContent =\r\n 