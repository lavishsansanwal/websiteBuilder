{
  "input": {
    "pageType": "dashboard",
    "prompt": "Create a premium modern project management dashboard for a software development team. Include project progress, task statistics, team members, upcoming deadlines, project activity, and interactive task filtering."
  },
  "output": {
    "message": "A premium interactive project management dashboard for a software development team.",
    "code": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>SupplyFlow — Logistics Dashboard</title>\r\n\r\n    <style>\r\n        :root {\r\n            --primary: #2563eb;\r\n            --primary-dark: #1d4ed8;\r\n            --accent: #7c3aed;\r\n            --background: #f6f8fc;\r\n            --surface: #ffffff;\r\n            --surface-secondary: #f8fafc;\r\n            --text-primary: #172033;\r\n            --text-secondary: #667085;\r\n            --border: #e6eaf0;\r\n            --success: #16a34a;\r\n            --warning: #d97706;\r\n            --danger: #dc2626;\r\n            --sidebar: #111827;\r\n            --sidebar-hover: #1f2937;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: Inter, Arial, sans-serif;\r\n            background: var(--background);\r\n            color: var(--text-primary);\r\n        }\r\n\r\n        button,\r\n        input,\r\n        select {\r\n            font: inherit;\r\n        }\r\n\r\n        button {\r\n            cursor: pointer;\r\n        }\r\n\r\n        .app {\r\n            min-height: 100vh;\r\n            display: flex;\r\n        }\r\n\r\n        /* SIDEBAR */\r\n\r\n        .sidebar {\r\n            width: 260px;\r\n            background: var(--sidebar);\r\n            color: white;\r\n            padding: 24px 16px;\r\n            display: flex;\r\n            flex-direction: column;\r\n            position: fixed;\r\n            top: 0;\r\n            bottom: 0;\r\n            left: 0;\r\n            z-index: 100;\r\n            transition: transform 0.3s ease;\r\n        }\r\n\r\n        .brand {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n            padding: 0 10px 32px;\r\n            font-size: 21px;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .brand-icon {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 10px;\r\n            background: var(--primary);\r\n            display: grid;\r\n            place-items: center;\r\n            font-size: 18px;\r\n        }\r\n\r\n        .nav-title {\r\n            color: #8b95a7;\r\n            font-size: 11px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 1px;\r\n            margin: 16px 10px 10px;\r\n        }\r\n\r\n        .nav-item {\r\n            width: 100%;\r\n            border: none;\r\n            background: transparent;\r\n            color: #b6bdca;\r\n            padding: 12px 14px;\r\n            border-radius: 9px;\r\n            text-align: left;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n            margin-bottom: 4px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .nav-item:hover,\r\n        .nav-item.active {\r\n            background: var(--sidebar-hover);\r\n            color: white;\r\n        }\r\n\r\n        .nav-item.active {\r\n            box-shadow: inset 3px 0 0 var(--primary);\r\n        }\r\n\r\n        .sidebar-bottom {\r\n            margin-top: auto;\r\n        }\r\n\r\n        .user-card {\r\n            border-top: 1px solid #273244;\r\n            padding: 18px 10px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .avatar {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 50%;\r\n            background: var(--accent);\r\n            display: grid;\r\n            place-items: center;\r\n            font-weight: 700;\r\n        }\r\n\r\n        .user-info strong {\r\n            display: block;\r\n            font-size: 13px;\r\n        }\r\n\r\n        .user-info span {\r\n            color: #9ca3af;\r\n            font-size: 12px;\r\n        }\r\n\r\n        /* MAIN */\r\n\r\n        .main {\r\n            margin-left: 260px;\r\n            width: calc(100% - 260px);\r\n            min-height: 100vh;\r\n        }\r\n\r\n        .topbar {\r\n            height: 78px;\r\n            background: var(--surface);\r\n            border-bottom: 1px solid var(--border);\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            padding: 0 34px;\r\n            position: sticky;\r\n            top: 0;\r\n            z-index: 50;\r\n        }\r\n\r\n        .menu-btn {\r\n            display: none;\r\n            border: none;\r\n            background: transparent;\r\n            font-size: 24px;\r\n        }\r\n\r\n        .search-box {\r\n            width: 320px;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n            background: var(--surface-secondary);\r\n            border: 1px solid var(--border);\r\n            border-radius: 10px;\r\n            padding: 10px 14px;\r\n        }\r\n\r\n        .search-box input {\r\n            width: 100%;\r\n            border: none;\r\n            outline: none;\r\n            background: transparent;\r\n        }\r\n\r\n        .top-actions {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 14px;\r\n        }\r\n\r\n        .icon-btn {\r\n            width: 40px;\r\n            height: 40px;\r\n            border: 1px solid var(--border);\r\n            background: white;\r\n            border-radius: 10px;\r\n        }\r\n\r\n        .content {\r\n            padding: 34px;\r\n        }\r\n\r\n        .page-heading {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: flex-start;\r\n            gap: 20px;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .page-heading h1 {\r\n            font-size: 28px;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .page-heading p {\r\n            color: var(--text-secondary);\r\n        }\r\n\r\n        .date-select {\r\n            border: 1px solid var(--border);\r\n            background: white;\r\n            padding: 10px 14px;\r\n            border-radius: 9px;\r\n            outline: none;\r\n        }\r\n\r\n        /* KPI CARDS */\r\n\r\n        .metrics {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 18px;\r\n            margin-bottom: 28px;\r\n        }\r\n\r\n        .metric-card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 14px;\r\n            padding: 22px;\r\n            transition: 0.2s;\r\n        }\r\n\r\n        .metric-card:hover {\r\n            transform: translateY(-3px);\r\n            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);\r\n        }\r\n\r\n        .metric-top {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 18px;\r\n        }\r\n\r\n        .metric-label {\r\n            color: var(--text-secondary);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .metric-icon {\r\n            width: 42px;\r\n            height: 42px;\r\n            border-radius: 10px;\r\n            display: grid;\r\n            place-items: center;\r\n            background: #eff6ff;\r\n            color: var(--primary);\r\n            font-size: 19px;\r\n        }\r\n\r\n        .metric-value {\r\n            font-size: 28px;\r\n            font-weight: 700;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .metric-change {\r\n            font-size: 13px;\r\n        }\r\n\r\n        .positive {\r\n            color: var(--success);\r\n        }\r\n\r\n        .negative {\r\n            color: var(--danger);\r\n        }\r\n\r\n        /* GRID */\r\n\r\n        .dashboard-grid {\r\n            display: grid;\r\n            grid-template-columns: 1.6fr 1fr;\r\n            gap: 22px;\r\n            margin-bottom: 22px;\r\n        }\r\n\r\n        .card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 14px;\r\n            padding: 24px;\r\n        }\r\n\r\n        .card-header {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            margin-bottom: 24px;\r\n        }\r\n\r\n        .card-header h2 {\r\n            font-size: 17px;\r\n        }\r\n\r\n        .card-header span {\r\n            color: var(--text-secondary);\r\n            font-size: 13px;\r\n        }\r\n\r\n        /* BAR CHART */\r\n\r\n        .chart {\r\n            height: 280px;\r\n            display: flex;\r\n            align-items: flex-end;\r\n            justify-content: space-between;\r\n            gap: 18px;\r\n            padding-top: 20px;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .bar-group {\r\n            flex: 1;\r\n            height: 100%;\r\n            display: flex;\r\n            flex-direction: column;\r\n            justify-content: flex-end;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .bar {\r\n            width: 100%;\r\n            max-width: 42px;\r\n            background: var(--primary);\r\n            border-radius: 7px 7px 2px 2px;\r\n            position: relative;\r\n            transition: height 0.5s ease;\r\n        }\r\n\r\n        .bar:hover {\r\n            background: var(--primary-dark);\r\n        }\r\n\r\n        .bar::after {\r\n            content: attr(data-value);\r\n            position: absolute;\r\n            top: -28px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            background: #172033;\r\n            color: white;\r\n            font-size: 11px;\r\n            padding: 5px 7px;\r\n            border-radius: 5px;\r\n            opacity: 0;\r\n            pointer-events: none;\r\n            transition: 0.2s;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .bar:hover::after {\r\n            opacity: 1;\r\n        }\r\n\r\n        .bar-label {\r\n            color: var(--text-secondary);\r\n            font-size: 12px;\r\n        }\r\n\r\n        /* DELIVERY STATUS */\r\n\r\n        .status-list {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 18px;\r\n        }\r\n\r\n        .status-item {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .status-left {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 12px;\r\n        }\r\n\r\n        .status-dot {\r\n            width: 11px;\r\n            height: 11px;\r\n            border-radius: 50%;\r\n        }\r\n\r\n        .dot-blue {\r\n            background: var(--primary);\r\n        }\r\n\r\n        .dot-green {\r\n            background: var(--success);\r\n        }\r\n\r\n        .dot-orange {\r\n            background: var(--warning);\r\n        }\r\n\r\n        .dot-red {\r\n            background: var(--danger);\r\n        }\r\n\r\n        .status-name {\r\n            font-size: 14px;\r\n        }\r\n\r\n        .status-number {\r\n            font-weight: 700;\r\n        }\r\n\r\n        .progress {\r\n            width: 100%;\r\n            height: 8px;\r\n            background: #eef1f5;\r\n            border-radius: 10px;\r\n            overflow: hidden;\r\n            margin-top: 8px;\r\n        }\r\n\r\n        .progress-bar {\r\n            height: 100%;\r\n            border-radius: inherit;\r\n            background: var(--primary);\r\n        }\r\n\r\n        /* TABLE */\r\n\r\n        .table-card {\r\n            background: var(--surface);\r\n            border: 1px solid var(--border);\r\n            border-radius: 14px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .table-header {\r\n            padding: 22px 24px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            border-bottom: 1px solid var(--border);\r\n        }\r\n\r\n        .table-header h2 {\r\n            font-size: 17px;\r\n        }\r\n\r\n        .view-all {\r\n            border: none;\r\n            background: transparent;\r\n            color: var(--primary);\r\n            font-weight: 600;\r\n        }\r\n\r\n        .table-wrapper {\r\n            overflow-x: auto;\r\n        }\r\n\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        th,\r\n        td {\r\n            text-align: left;\r\n            padding: 17px 24px;\r\n            border-bottom: 1px solid var(--border);\r\n            white-space: nowrap;\r\n        }\r\n\r\n        th {\r\n            font-size: 12px;\r\n            color: var(--text-secondary);\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n            background: var(--surface-secondary);\r\n        }\r\n\r\n        td {\r\n            font-size: 14px;\r\n        }\r\n\r\n        tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .shipment-id {\r\n            color: var(--primary);\r\n            font-weight: 600;\r\n        }\r\n\r\n        .badge {\r\n            display: inline-flex;\r\n            padding: 6px 10px;\r\n            border-radius: 20px;\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .delivered {\r\n            background: #dcfce7;\r\n            color: #15803d;\r\n        }\r\n\r\n        .transit {\r\n            background: #dbeafe;\r\n            color: #1d4ed8;\r\n        }\r\n\r\n        .delayed {\r\n            background: #fef3c7;\r\n            color: #b45309;\r\n        }\r\n\r\n        .overlay {\r\n            display: none;\r\n        }\r\n\r\n        @media (max-width: 1200px) {\r\n            .metrics {\r\n                grid-template-columns: repeat(2, 1fr);\r\n            }\r\n\r\n            .dashboard-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 768px) {\r\n            .sidebar {\r\n                transform: translateX(-100%);\r\n                box-shadow: 10px 0 30px rgba(0, 0, 0, 0.15);\r\n            }\r\n\r\n            .sidebar.open {\r\n                transform: translateX(0);\r\n            }\r\n\r\n            .overlay {\r\n                position: fixed;\r\n                inset: 0;\r\n                background: rgba(0, 0, 0, 0.4);\r\n                z-index: 90;\r\n            }\r\n\r\n            .overlay.show {\r\n                display: block;\r\n            }\r\n\r\n            .main {\r\n                margin-left: 0;\r\n                width: 100%;\r\n            }\r\n\r\n            .topbar {\r\n                padding: 0 18px;\r\n            }\r\n\r\n            .menu-btn {\r\n                display: block;\r\n            }\r\n\r\n            .search-box {\r\n                display: none;\r\n            }\r\n\r\n            .content {\r\n                padding: 22px 18px;\r\n            }\r\n\r\n            .page-heading {\r\n                flex-direction: column;\r\n            }\r\n\r\n            .metrics {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 480px) {\r\n            .top-actions .icon-btn:not(:last-child) {\r\n                display: none;\r\n            }\r\n\r\n            .card,\r\n            .metric-card {\r\n                padding: 18px;\r\n            }\r\n\r\n            .chart {\r\n                gap: 8px;\r\n            }\r\n\r\n            .bar-label {\r\n                font-size: 10px;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"app\">\r\n\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n\r\n        <div class=\"brand\">\r\n            <div class=\"brand-icon\">SF</div>\r\n            <span>SupplyFlow</span>\r\n        </div>\r\n\r\n        <div class=\"nav-title\">Workspace</div>\r\n\r\n        <button class=\"nav-item active\" data-view=\"Overview\">\r\n            <span>◫</span> Overview\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"Shipments\">\r\n            <span>▣</span> Shipments\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"Inventory\">\r\n            <span>▤</span> Inventory\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"Analytics\">\r\n            <span>◔</span> Analytics\r\n        </button>\r\n\r\n        <div class=\"nav-title\">Management</div>\r\n\r\n        <button class=\"nav-item\" data-view=\"Suppliers\">\r\n            <span>◉</span> Suppliers\r\n        </button>\r\n\r\n        <button class=\"nav-item\" data-view=\"Settings\">\r\n            <span>⚙</span> Settings\r\n        </button>\r\n\r\n        <div class=\"sidebar-bottom\">\r\n\r\n            <div class=\"user-card\">\r\n                <div class=\"avatar\">LC</div>\r\n\r\n                <div class=\"user-info\">\r\n                    <strong>Logistics Team</strong>\r\n                    <span>Administrator</span>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </aside>\r\n\r\n    <div class=\"overlay\" id=\"overlay\"></div>\r\n\r\n    <main class=\"main\">\r\n\r\n        <header class=\"topbar\">\r\n\r\n            <button class=\"menu-btn\" id=\"menuBtn\">☰</button>\r\n\r\n            <div class=\"search-box\">\r\n                <span>⌕</span>\r\n                <input\r\n                    type=\"text\"\r\n                    id=\"searchInput\"\r\n                    placeholder=\"Search shipments...\"\r\n                />\r\n            </div>\r\n\r\n            <div class=\"top-actions\">\r\n                <button class=\"icon-btn\">🔔</button>\r\n                <button class=\"icon-btn\">?</button>\r\n                <button class=\"icon-btn\">⚙</button>\r\n            </div>\r\n\r\n        </header>\r\n\r\n        <div class=\"content\">\r\n\r\n            <div class=\"page-heading\">\r\n\r\n                <div>\r\n                    <h1 id=\"pageTitle\">Logistics Overview</h1>\r\n                    <p>Monitor your supply chain and shipment performance.</p>\r\n                </div>\r\n\r\n                <select class=\"date-select\" id=\"dateRange\">\r\n                    <option>This Month</option>\r\n                    <option>Last 30 Days</option>\r\n                    <option>This Quarter</option>\r\n                    <option>This Year</option>\r\n                </select>\r\n\r\n            </div>\r\n\r\n            <section class=\"metrics\">\r\n\r\n                <div class=\"metric-card\">\r\n\r\n                    <div class=\"metric-top\">\r\n                        <span class=\"metric-label\">Active Shipments</span>\r\n                        <div class=\"metric-icon\">▣</div>\r\n                    </div>\r\n\r\n                    <div class=\"metric-value\" id=\"activeShipments\">\r\n                        1,248\r\n                    </div>\r\n\r\n                    <div class=\"metric-change positive\">\r\n                        ↑ 12.4% from last month\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"metric-card\">\r\n\r\n                    <div class=\"metric-top\">\r\n                        <span class=\"metric-label\">On-Time Delivery</span>\r\n                        <div class=\"metric-icon\">✓</div>\r\n                    </div>\r\n\r\n                    <div class=\"metric-value\">94.8%</div>\r\n\r\n                    <div class=\"metric-change positive\">\r\n                        ↑ 3.2% improvement\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"metric-card\">\r\n\r\n                    <div class=\"metric-top\">\r\n                        <span class=\"metric-label\">Total Inventory</span>\r\n                        <div class=\"metric-icon\">▤</div>\r\n                    </div>\r\n\r\n                    <div class=\"metric-value\">28,540</div>\r\n\r\n                    <div class=\"metric-change positive\">\r\n                        ↑ 8.7% from last month\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class=\"metric-card\">\r\n\r\n                    <div class=\"metric-top\">\r\n                        <span class=\"metric-label\">Delayed Shipments</span>\r\n                        <div class=\"metric-icon\">!</div>\r\n                    </div>\r\n\r\n                    <div class=\"metric-value\">36</div>\r\n\r\n                    <div class=\"metric-change negative\">\r\n                        ↑ 4.1% from last month\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </section>\r\n\r\n            <section class=\"dashboard-grid\">\r\n\r\n                <div class=\"card\">\r\n\r\n                    <div class=\"card-header\">\r\n                        <div>\r\n                            <h2>Shipment Volume</h2>\r\n                            <span>Weekly shipment activity</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"chart\">\r\n\r\n                        <div class=\"bar-group\">\r\n                            <div class=\"bar\" data-value=\"420\" style=\"height: 58%;\"></div>\r\n                            <span class=\"bar-label\">Mon</span>\r\n                        </div>\r\n\r\n                        <div class=\"bar-group\">\r\n                            <div class=\"bar\" data-value=\"580\" style=\"height: 7